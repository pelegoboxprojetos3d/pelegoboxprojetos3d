import {
  criarCobrancaPixTransparente as criarPixRapido,
  consultarCobrancaPix as consultarPixRapido
} from "backend/validaPayPixProjetosProntosRapido.jsw";

/*
  Fachada oficial do PIX de Projetos Prontos.
  Mantém o nome/import já usado pelas páginas, mas delega para o fluxo rápido.

  Regras atuais:
  - não cria produto ValidaPay no caminho crítico;
  - não depende de SKU;
  - codigo_checkout não é obrigatório para gerar Pix;
  - título é preservado/decodificado pelo backend rápido;
  - checkoutId continua garantindo recuperação/idempotência da tentativa.
*/
export async function criarCobrancaPixTransparente(input = {}) {
  return criarPixRapido(input);
}

export async function consultarCobrancaPix(input = {}) {
  return consultarPixRapido(input);
}
