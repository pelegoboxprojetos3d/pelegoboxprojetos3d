import wixData from "wix-data";
import { fetch } from "wix-fetch";
import { getSecret } from "wix-secrets-backend";
import { currentMember as currentMemberBackend } from "wix-members-backend";
import { tokenize } from "@validapay/tokenize";
import { buscarMetodoPagamentoPrivadoPorEmail, salvarMetodoPagamentoAprovado } from "backend/metodosPagamentoProjetosProntos";
import { tituloEtapaProjetoPronto, normalizarTituloProduto, extrairCodigoQuestionarioTitulo } from "backend/projetosProntosNormalizacao";
import { notificarVendaProjetoProntoAprovada } from "backend/notificarVendaProjetoPronto";

async function identidadeMembroAtualCartao() {
  const membro = await currentMemberBackend.getMember();
  const emails = Array.isArray(membro?.contactDetails?.emails) ? membro.contactDetails.emails : [];
  const memberId = safe(membro?._id);
  const email = safe(membro?.loginEmail || emails[0] || membro?.contactDetails?.email).toLowerCase();
  return { memberId, email };
}

async function tokenizarNovoCartao({ number, cvv, month, year, holder, nome, cpfCnpj, email }) {
  const clientId = safe(await getSecret("VALIDAPAY_CLIENT_ID"));
  const clientSecret = safe(await getSecret("VALIDAPAY_CLIENT_SECRET"));
  if (!clientId || !clientSecret) throw new Error("Credenciais ValidaPay não configuradas para tokenização.");

  const result = await tokenize({
    clientId,
    clientSecret,
    card: {
      number,
      cardHolderName: holder,
      cvv,
      expiration: `${month}/${year}`
    },
    customer: {
      name: nome,
      document: cpfCnpj,
      email
    }
  });

  if (!safe(result?.paymentMethodId)) throw new Error("A ValidaPay não retornou o token seguro do cartão.");
  return result;
}

async function persistirMetodoPagamentoAprovado(session, chargeId) {
  const paymentMethodId = safe(session?.pendingPaymentMethodId);
  const email = safe(session?.email).toLowerCase();
  if (!paymentMethodId || !email) return null;
  try {
    return await salvarMetodoPagamentoAprovado({
      email,
      memberId: safe(session?.memberId),
      clienteId: safe(session?.clienteId),
      paymentMethodId,
      validaPayCustomerId: safe(session?.pendingValidaPayCustomerId),
      cardBrand: safe(session?.pendingCardBrand),
      cardLastFour: safe(session?.pendingCardLastFour),
      cardExpirationMonth: safe(session?.pendingCardExpirationMonth),
      cardExpirationYear: safe(session?.pendingCardExpirationYear),
      cardHolderName: safe(session?.pendingCardHolderName),
      cardDocument: safe(session?.pendingCardDocument || session?.cpfCnpj),
      ultimoPagamentoId: safe(chargeId)
    });
  } catch (error) {
    console.warn("Falha ao salvar método de pagamento tokenizado:", error?.message || error);
    return null;
  }
}

// CARTÃO TRANSPARENTE VALIDAPAY
// - Não grava PAN completo nem CVV.
// - Não depende de SKU nem de codigo_checkout.
// - Vincula a cobrança a um produto/preço ValidaPay quando possível.
// - Quando a ValidaPay aprova imediatamente, registra a compra e dispara o Make
//   antes de devolver sucesso ao checkout.

const AUTH_URL = "https://oauth2.validapay.com.br/auth/token";
const API_BASE = "https://api.validapay.com.br";
const SESSIONS = "SessoesProjetosProntos2";
const PURCHASES = "ComprasProjetos";
const MAKE_SECRET = "MAKE_WEBHOOK_PROJETOS_PRONTOS";
const DB = { suppressAuth: true };

let cachedToken = "";
let tokenExpiresAt = 0;

const safe = v => String(v ?? "").trim();
const digits = v => safe(v).replace(/\D/g, "");

function money(v) {
  if (typeof v === "number") return Number.isFinite(v) ? Number(v.toFixed(2)) : 0;
  let t = safe(v).replace(/[^\d,.-]/g, "");
  if (t.includes(",") && t.includes(".")) t = t.replace(/\./g, "").replace(",", ".");
  else if (t.includes(",")) t = t.replace(",", ".");
  const n = Number(t);
  return Number.isFinite(n) ? Number(n.toFixed(2)) : 0;
}

function phone(v) {
  const original = safe(v);
  let n = digits(original);
  if (!n) return "";
  if (original.startsWith("+") && n.length >= 7 && n.length <= 15) return `+${n}`;
  if (n.startsWith("55") && (n.length === 12 || n.length === 13)) return `+${n}`;
  if (n.length === 10 || n.length === 11) return `+55${n}`;
  if (n.length >= 7 && n.length <= 15) return `+${n}`;
  return "";
}


function productType(v) {
  const t = safe(v)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toUpperCase()
    .replace(/[\s-]+/g, "_");
  return ["MEDIDAS", "GRAFICOS", "PROJETO_COMPLETO"].includes(t) ? t : "MEDIDAS";
}

function priceTitleForType(value) {
  const tipo = productType(value);
  if (tipo === "GRAFICOS") return "Botão 2";
  if (tipo === "PROJETO_COMPLETO") return "Botão 3";
  return "Botão 1";
}

function decodeTitle(v) {
  return safe(v)
    .replace(/&amp;quot;/gi, '"')
    .replace(/&quot;|&#34;|&#x22;/gi, '"')
    .replace(/&apos;|&#39;/gi, "'")
    .replace(/&amp;/gi, "&")
    .replace(/\s+/g, " ")
    .trim();
}

function luhn(v) {
  const n = digits(v);
  if (n.length < 13 || n.length > 19) return false;
  let sum = 0;
  let alt = false;
  for (let i = n.length - 1; i >= 0; i -= 1) {
    let d = Number(n[i]);
    if (alt) { d *= 2; if (d > 9) d -= 9; }
    sum += d;
    alt = !alt;
  }
  return sum % 10 === 0;
}

function cardAttemptExternalId(checkoutId, attempt) {
  const base = safe(checkoutId).replace(/[^a-z0-9_-]/gi, "").slice(0, 54);
  const sequence = Math.max(1, Number(attempt || 1));
  return `${base}-C${sequence}`.slice(0, 64);
}

function isApprovedCardStatus(value) {
  return ["paid", "approved", "succeeded"].includes(safe(value).toLowerCase());
}

function isTerminalCardFailure(value) {
  return ["rejected", "declined", "denied", "failed", "cancelled", "canceled", "expired", "refused"].includes(safe(value).toLowerCase());
}

function extractChargeId(data = {}) {
  return safe(
    data?.chargeId ||
    data?.id ||
    data?.data?.chargeId ||
    data?.data?.id ||
    data?.charge?.chargeId ||
    data?.charge?.id ||
    data?.payment?.chargeId ||
    data?.payment?.id ||
    data?.result?.chargeId ||
    data?.result?.id ||
    data?.error?.details?.chargeId ||
    data?.details?.chargeId
  );
}

function extractChargeStatus(data = {}) {
  return safe(
    data?.status ||
    data?.data?.status ||
    data?.charge?.status ||
    data?.payment?.status ||
    data?.result?.status
  ).toLowerCase();
}

function brand(v) {
  const n = digits(v);
  if (/^(4011|4312|4389|4514|4576|5041|5066|5067|509|6277|6362|6363)/.test(n)) return "ELO";
  if (/^(34|37)/.test(n)) return "AMEX";
  if (/^(5[1-5]|2[2-7])/.test(n)) return "MASTERCARD";
  if (/^4/.test(n)) return "VISA";
  return "CARD";
}

function generateDeliveryToken() {
  return `entpro_${Date.now().toString(36)}_${Math.random().toString(16).slice(2)}${Math.random().toString(16).slice(2)}`;
}

async function json(response) {
  const text = await response.text();
  if (!text) return {};
  try { return JSON.parse(text); } catch (_) { return { raw: text }; }
}

function message(data, status) {
  return safe(
    data?.error?.message ||
    data?.error_description ||
    data?.message ||
    (typeof data?.error === "string" ? data.error : "") ||
    data?.code ||
    data?.raw
  ) || `ValidaPay respondeu HTTP ${status}.`;
}

async function token(force = false) {
  if (!force && cachedToken && Date.now() < tokenExpiresAt - 60000) return cachedToken;

  const id = safe(await getSecret("VALIDAPAY_CLIENT_ID"));
  const secret = safe(await getSecret("VALIDAPAY_CLIENT_SECRET"));
  if (!id || !secret) throw new Error("Credenciais da ValidaPay não encontradas.");

  const body = [
    "grant_type=client_credentials",
    `client_id=${encodeURIComponent(id)}`,
    `client_secret=${encodeURIComponent(secret)}`,
    `scope=${encodeURIComponent("checkouts/write products/write products/read checkouts/read pix.cob/read")}`
  ].join("&");

  const response = await fetch(AUTH_URL, {
    method: "post",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body
  });

  const data = await json(response);
  if (!response.ok || !safe(data?.access_token)) throw new Error(message(data, response.status));

  cachedToken = safe(data.access_token);
  tokenExpiresAt = Date.now() + Math.max(120, Number(data?.expires_in || 300)) * 1000;
  return cachedToken;
}

async function api(method, path, body) {
  for (let attempt = 1; attempt <= 2; attempt += 1) {
    const access = await token(attempt > 1);
    const options = {
      method,
      headers: {
        Authorization: `Bearer ${access}`,
        "Content-Type": "application/json"
      }
    };
    if (body !== undefined) options.body = JSON.stringify(body);

    const response = await fetch(`${API_BASE}${path}`, options);
    const data = await json(response);

    if (response.ok) return { ok: true, statusCode: response.status, data };

    if (attempt === 1 && [401, 403].includes(Number(response.status))) {
      cachedToken = "";
      tokenExpiresAt = 0;
      continue;
    }

    return {
      ok: false,
      statusCode: response.status,
      data,
      error: message(data, response.status)
    };
  }

  return { ok: false, statusCode: 0, data: {}, error: "Falha ao consultar a ValidaPay." };
}

async function reenviarNotificacaoValidaPay(chargeId) {
  const id = safe(chargeId);
  if (!id) return { sent: false, error: "charge_id_missing" };

  // O painel da ValidaPay consegue reenviar depois que a cobrança já está materializada.
  // Na aprovação transparente a consulta pode chegar cedo demais, então aguardamos e repetimos
  // somente em caso de falha. Uma resposta 2xx encerra imediatamente e não consome reenvios extras.
  const waits = [0, 900, 2200];
  let last = { sent: false, error: "notification_resend_failed" };

  for (let attempt = 0; attempt < waits.length; attempt += 1) {
    if (waits[attempt]) await new Promise(resolve => setTimeout(resolve, waits[attempt]));
    try {
      const response = await api("post", "/v1/users/notifications/resend", { chargeId: id });
      const providerConfirmed = response.ok && response.data?.success === true;
      if (providerConfirmed) {
        return {
          sent: true,
          statusCode: response.statusCode,
          event: safe(response.data?.event),
          success: response.data?.success === true,
          attempt: attempt + 1
        };
      }
      last = {
        sent: false,
        statusCode: response.statusCode,
        error: response.ok && response.data?.success !== true ? "notification_not_confirmed" : (response.error || "notification_resend_failed"),
        attempt: attempt + 1
      };
      console.warn("ValidaPay não enviou a notificação da fatura:", response.statusCode, response.error);
    } catch (error) {
      last = { sent: false, error: error?.message || "notification_resend_error", attempt: attempt + 1 };
      console.warn("Falha ao chamar reenvio de notificação ValidaPay:", error?.message || error);
    }
  }

  return last;
}

async function garantirFaturaValidaPay(checkoutId, chargeId, knownSession = null) {
  const session = knownSession || await findSession(checkoutId);

  if (session?.faturaValidaPayEnviada === true) {
    return { sent: true, skipped: true, reason: "already_sent" };
  }

  const ultimaTentativa = new Date(
    session?.faturaValidaPayUltimaTentativaEm || 0
  ).getTime();

  if (ultimaTentativa && Date.now() - ultimaTentativa < 8000) {
    return {
      sent: false,
      skipped: true,
      reason: "cooldown",
      statusCode: Number(session?.faturaValidaPayStatusCode || 0),
      error: safe(session?.faturaValidaPayErro)
    };
  }

  await saveSession(checkoutId, {
    faturaValidaPayUltimaTentativaEm: new Date(),
    updatedAtDate: new Date()
  }, session || undefined);

  const result = await reenviarNotificacaoValidaPay(chargeId);

  await saveSession(checkoutId, {
    faturaValidaPayEnviada: result?.sent === true,
    faturaValidaPayStatusCode: Number(result?.statusCode || 0),
    faturaValidaPayErro: safe(result?.error),
    faturaValidaPayTentativa: Number(result?.attempt || 0),
    faturaValidaPayUltimaTentativaEm: new Date(),
    updatedAtDate: new Date()
  });

  return result;
}

async function findSession(checkoutId) {
  const r = await wixData
    .query(SESSIONS)
    .eq("checkoutId", safe(checkoutId))
    .limit(1)
    .find({ ...DB, consistentRead: true });
  return r.items[0] || null;
}

async function saveSession(checkoutId, patch) {
  const current = await findSession(checkoutId);
  const item = { ...(current || {}), ...(patch || {}), checkoutId: safe(checkoutId) };
  delete item.whatsApp;
  delete item.whatsappE164;
  delete item.sku;
  delete item.codigoCheckout;
  return current ? wixData.update(SESSIONS, item, DB) : wixData.insert(SESSIONS, item, DB);
}


async function buscarPriceIdExistenteValidaPay({ produto, valor, tipoProduto }) {
  const nomeEsperado = normalizarTituloProduto(produto).toLowerCase();
  const tituloPrecoEsperado = priceTitleForType(tipoProduto).toUpperCase();
  if (!nomeEsperado || !(Number(valor) > 0)) return "";

  try {
    const lista = await api("get", `/v1/products?limit=50&status=active&search=${encodeURIComponent(produto)}`);
    if (!lista.ok) return "";

    const items = lista.data?.items || lista.data?.data?.items || [];
    for (const item of items) {
      if (normalizarTituloProduto(item?.name).toLowerCase() !== nomeEsperado) continue;

      let detalhe = item;
      let prices = item?.prices || [];
      const productId = safe(item?.productId || item?.id);

      if (productId) {
        const respostaDetalhe = await api("get", `/v1/products/${encodeURIComponent(productId)}`);
        if (respostaDetalhe.ok) detalhe = respostaDetalhe.data?.data || respostaDetalhe.data || detalhe;
        prices = detalhe?.prices || detalhe?.data?.prices || [];
      }

      const descricaoProduto = normalizarTituloProduto(detalhe?.description).toLowerCase();
      if (descricaoProduto && descricaoProduto === nomeEsperado) continue;

      const preco = (Array.isArray(prices) ? prices : []).find(price =>
        safe(price?.priceId || price?.id) &&
        safe(price?.title).toUpperCase() === tituloPrecoEsperado &&
        Math.abs(Number(price?.amount || 0) - Number(valor || 0)) <= 0.01 &&
        (!safe(price?.recurrenceType) || safe(price?.recurrenceType).toUpperCase() === "ONE_TIME")
      );

      if (preco) return safe(preco?.priceId || preco?.id);
    }
  } catch (error) {
    console.warn("Não foi possível localizar produto existente na ValidaPay:", error?.message || error);
  }

  return "";
}

async function reusablePriceId({ codigoProjeto, tipoProduto, produto, valor }) {
  try {
    const r = await wixData
      .query(SESSIONS)
      .eq("codigoProjeto", safe(codigoProjeto))
      .eq("tipoProduto", safe(tipoProduto))
      .descending("_updatedDate")
      .limit(100)
      .find(DB);

    const found = (r.items || []).find(item =>
      safe(item?.validaPayPriceId) && normalizarTituloProduto(item?.produto).toLowerCase() === normalizarTituloProduto(produto).toLowerCase() && Math.abs(Number(item?.valor || 0) - Number(valor || 0)) <= 0.01
    );

    return safe(found?.validaPayPriceId);
  } catch (error) {
    console.warn("Não foi possível reutilizar priceId ValidaPay:", error?.message || error);
    return "";
  }
}


async function ensurePriceId({ checkoutId, codigoProjeto, tipoProduto, produto, valor }) {
  const current = await findSession(checkoutId);
  const tituloPreco = priceTitleForType(tipoProduto);
  if (safe(current?.validaPayPriceId) && safe(current?.validaPayPriceLabel) === tituloPreco && normalizarTituloProduto(current?.produto).toLowerCase() === normalizarTituloProduto(produto).toLowerCase()) return safe(current.validaPayPriceId);
  const providerReused = await buscarPriceIdExistenteValidaPay({ produto, valor, tipoProduto });
  if (providerReused) {
    await saveSession(checkoutId, { validaPayPriceId: providerReused, validaPayPriceLabel: tituloPreco, updatedAtDate: new Date() });
    return providerReused;
  }

  const response = await api("post", "/v1/products", {
    name: produto,
    type: "ONE_TIME",
    statementDescriptor: "PELEGO BOX",
    isActive: true,
    metadata: {
      origem: "PELEGO_BOX_PROJETOS_PRONTOS",
      codigoProjeto,
      tipoProduto,
      codigoQuestionario: extrairCodigoQuestionarioTitulo(produto)
    },
    prices: [{
      title: tituloPreco,
      amount: valor,
      currency: "BRL",
      recurrenceType: "ONE_TIME",
      recurrenceInterval: 1
    }]
  });

  if (!response.ok) {
    console.warn("Produto ValidaPay não pôde ser criado. Cobrança seguirá avulsa:", response.error);
    return "";
  }

  const priceId = safe(response.data?.prices?.[0]?.priceId);
  if (priceId) {
    await saveSession(checkoutId, { validaPayPriceId: priceId, validaPayPriceLabel: tituloPreco, updatedAtDate: new Date() });
  }
  return priceId;
}

async function findPurchase(chaveCompra) {
  if (!safe(chaveCompra)) return null;
  const r = await wixData.query(PURCHASES).eq("chaveCompra", safe(chaveCompra)).limit(1).find(DB);
  return r.items[0] || null;
}

function cumulativeAccess(existing, tipoProduto) {
  const projeto = existing?.downloadProjeto === true || tipoProduto === "PROJETO_COMPLETO";
  const graficos = existing?.downloadGraficos === true || tipoProduto === "GRAFICOS" || projeto;
  const medidas = existing?.downloadMedidas === true || tipoProduto === "MEDIDAS" || graficos;
  return { medidas, graficos, projeto };
}


function processingIsStale(item) {
  const stamp = new Date(item?.dataProcessamento || item?._updatedDate || 0).getTime();
  return !stamp || (Date.now() - stamp) > 15000;
}
function shouldTriggerMake(purchase) {
  const status = safe(purchase?.statusProcessamento).toUpperCase();
  if (status === "PROCESSADO") return false;
  if (status === "PROCESSANDO" && !processingIsStale(purchase)) return false;
  return true;
}
async function setProcessing(purchase, status) {
  if (!purchase?._id) return purchase;
  return wixData.update(PURCHASES, {...purchase,statusProcessamento:status,dataProcessamento:new Date()},DB);
}

async function triggerMake({ session, purchase, paymentId }) {
  if (!shouldTriggerMake(purchase)) return { sent:false, skipped:true, reason:"already_processing_or_done" };
  const url = safe(await getSecret(MAKE_SECRET));
  if (!url) return { sent:false, error:"make_secret_missing" };
  let processingPurchase = purchase;
  try { processingPurchase = await setProcessing(purchase,"PROCESSANDO"); } catch (_) {}
  const payload = {
    event:"pagamento_aprovado_projeto_pronto",clienteId:safe(session.clienteId),nomeCliente:safe(session.nomeCliente),
    email:safe(session.email).toLowerCase(),whatsapp:phone(session.whatsapp),cpfCnpj:digits(session.cpfCnpj),
    codigoProjeto:digits(session.codigoProjeto),produto:decodeTitle(session.produto),tipoProduto:productType(session.tipoProduto),
    valor:Number(processingPurchase?.valor || session.valor || 0),pagamento:"approved",statusCompra:"approved",
    idPagamento:safe(paymentId),checkoutId:safe(session.checkoutId),tokenDeEntrega:safe(session.tokenEntrega),chaveCompra:safe(processingPurchase?.chaveCompra)
  };
  try {
    const response = await fetch(url,{method:"post",headers:{"Content-Type":"application/json"},body:JSON.stringify(payload)});
    if (!response.ok) {
      try { await setProcessing(processingPurchase,"PENDENTE"); } catch (_) {}
      return {sent:false,error:"make_http_error",status:response.status};
    }
    return {sent:true};
  } catch(error) {
    try { await setProcessing(processingPurchase,"PENDENTE"); } catch (_) {}
    return {sent:false,error:"make_fetch_error"};
  }
}

async function finalizeApprovedCard({ checkoutId, chargeId }) {
  let session = await findSession(checkoutId);
  if (!session) throw new Error("Sessão do cartão não encontrada após aprovação.");
  await persistirMetodoPagamentoAprovado(session, chargeId);
  const codigoProjeto=digits(session.codigoProjeto),clienteId=safe(session.clienteId),tipoProduto=productType(session.tipoProduto);
  const chaveCompra=`${clienteId}_${codigoProjeto}`;
  const existente=await findPurchase(chaveCompra);
  if (session.compraRegistrada===true && safe(session.status).toLowerCase()==="approved" && existente) {
    const make=await triggerMake({session,purchase:existente,paymentId:chargeId});
    const notificacao=await notificarVendaProjetoProntoAprovada({
      checkoutId,
      chargeId,
      paymentMethod:"CARD"
    });
    const faturaValidaPay={sent:false,skipped:true,reason:"provider_native_resend_not_supported_public_api"};
    return {compraRegistrada:true,purchaseId:safe(existente._id),tokenEntrega:safe(session.tokenEntrega),make,notificacao,faturaValidaPay};
  }
  const samePayment=Boolean(existente && safe(existente.idPagamento)===safe(chargeId));
  const access=cumulativeAccess(existente,tipoProduto),now=new Date();
  if(!safe(session.tokenEntrega)) session.tokenEntrega=generateDeliveryToken();
  session.status="approved";session.paymentId=safe(chargeId);session.validaPayChargeId=safe(chargeId);session.compraRegistrada=false;session.updatedAtDate=now;
  await saveSession(checkoutId,session);
  const previousValue=Number(existente?.valor||0),stageValue=Number(session.valor||0),totalValue=samePayment?previousValue:previousValue+stageValue;
  const purchase={...(existente||{}),title:`PP-${codigoProjeto} - ${safe(session.nomeCliente)||clienteId}`,chaveCompra,clienteId,codigoProjeto,tipoProduto,
    nomeCliente:safe(session.nomeCliente),email:safe(session.email).toLowerCase(),whatsapp:phone(session.whatsapp),cpfCnpj:digits(session.cpfCnpj),
    checkoutId:safe(session.checkoutId),tokenDeEntrega:safe(session.tokenEntrega),idPagamento:safe(chargeId),pagamento:"approved",statusCompra:"approved",valor:totalValue,
    dataCompra:existente?.dataCompra||now,dataLiberacao:now,downloadMedidas:access.medidas,downloadGraficos:access.graficos,downloadProjeto:access.projeto,
    statusProcessamento:samePayment?(safe(existente?.statusProcessamento)||"PENDENTE"):"PENDENTE",dataProcessamento:now};
  delete purchase.whatsApp;
  const savedPurchase=existente?await wixData.update(PURCHASES,purchase,DB):await wixData.insert(PURCHASES,purchase,DB);
  session=await saveSession(checkoutId,{status:"approved",paymentId:safe(chargeId),validaPayChargeId:safe(chargeId),tokenEntrega:safe(session.tokenEntrega),compraRegistrada:true,updatedAtDate:new Date()});
  const make=await triggerMake({session,purchase:savedPurchase,paymentId:chargeId});
  const notificacao=await notificarVendaProjetoProntoAprovada({
    checkoutId,
    chargeId,
    paymentMethod:"CARD"
  });
  // A rota /v1/users/notifications/resend pertence ao painel e não aceita
  // o OAuth client_credentials da API pública. Não bloqueamos mais o cliente
  // com três tentativas 401 depois de o pagamento já estar aprovado.
  const faturaValidaPay={sent:false,skipped:true,reason:"provider_native_resend_not_supported_public_api"};
  return {compraRegistrada:true,purchaseId:safe(savedPurchase?._id),tokenEntrega:safe(session.tokenEntrega),make,notificacao,faturaValidaPay};
}

export async function criarCobrancaCartaoTransparente(input = {}) {
  const card = input.card || {};
  const useSavedPaymentMethod = input.useSavedPaymentMethod === true;
  const number = digits(card.number);
  const cvv = digits(card.cvv);
  const month = digits(card.month).padStart(2, "0").slice(-2);
  let year = digits(card.year);
  if (year.length === 2) year = `20${year}`;
  const holder = safe(card.name).replace(/\s+/g, " ").toUpperCase();

  try {
    const ctx = input.ctx || {};
    const checkoutId = safe(input.checkoutId);
    const codigoProjeto = digits(input.codigoProjeto || ctx.codigoProjeto);
    const tipoProduto = productType(input.tipoProduto || ctx.tipoProduto);
    const produto = tituloEtapaProjetoPronto(input.produto || ctx.produto || ctx.titulo || "Projeto Pronto", tipoProduto, codigoProjeto);
    const tituloCheckout = decodeTitle(input.tituloCheckout || ctx.titulo || "");
    const valor = money(input.valor ?? ctx.valor ?? ctx.price);
    const clienteId = safe(input.clienteId || ctx.clienteId);
    const nome = safe(input.nome || input.nomeCliente || ctx.nome || ctx.nomeCliente);
    const emailInformado = safe(input.email || ctx.email).toLowerCase();
    let identidadeMembro = { memberId: "", email: "" };
    try {
      identidadeMembro = await identidadeMembroAtualCartao();
    } catch (error) {
      console.warn("Identidade Wix indisponível no cartão; usando cadastro já validado do checkout:", error?.message || error);
    }
    if (identidadeMembro.email && emailInformado && emailInformado !== identidadeMembro.email) {
      return { ok:false, error:"O e-mail do checkout não corresponde ao login atual." };
    }
    const email = identidadeMembro.email || emailInformado;
    const memberId = identidadeMembro.memberId;
    const cpfCnpj = digits(input.cpfCnpj || ctx.cpfCnpj);
    const whatsapp = phone(input.whatsappE164 || input.whatsapp || ctx.whatsappE164 || ctx.whatsapp);
    const cardDocument = digits(input.cardDocument || cpfCnpj);
    const installments = Math.min(12, Math.max(1, Number(input.installments || 1)));

    if (!checkoutId || !codigoProjeto || !(valor > 0)) return { ok: false, error: "Dados do produto incompletos." };
    if (!clienteId || nome.length < 3 || !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i.test(email) || !whatsapp || ![11, 14].includes(cpfCnpj.length)) {
      return { ok: false, error: "Dados do comprador incompletos." };
    }
    if (!useSavedPaymentMethod) {
      if (!luhn(number)) return { ok: false, error: "Número do cartão inválido." };
      if (!/^(0[1-9]|1[0-2])$/.test(month) || !/^20\d{2}$/.test(year)) return { ok: false, error: "Validade do cartão inválida." };
      if (!/^\d{3,4}$/.test(cvv)) return { ok: false, error: "CVV inválido." };
      if (holder.length < 3) return { ok: false, error: "Nome impresso no cartão inválido." };
    }
    if (![11, 14].includes(cardDocument.length)) return { ok: false, error: "CPF/CNPJ do portador inválido." };

    const previousSession = await findSession(checkoutId);
    const previousMethod = safe(previousSession?.paymentMethod).toUpperCase();
    const previousChargeId = previousMethod === "CARD"
      ? safe(previousSession?.validaPayChargeId || previousSession?.paymentId)
      : "";
    const previousStatus = safe(previousSession?.status).toLowerCase();
    let cardAttempt = Math.max(1, Number(previousSession?.cardAttempt || 1));

    if (previousChargeId) {
      const previousResponse = await api("get", `/v1/charges/${encodeURIComponent(previousChargeId)}`);

      if (!previousResponse.ok) {
        return {
          ok: true,
          recoverable: true,
          processing: true,
          chargeId: previousChargeId,
          status: previousStatus || "pending",
          error: "A tentativa anterior ainda está sendo conferida pela operadora."
        };
      }

      const previousData = previousResponse.data?.data || previousResponse.data?.charge || previousResponse.data || {};
      const liveStatus = extractChargeStatus(previousData);

      if (isApprovedCardStatus(liveStatus)) {
        await saveSession(checkoutId, {
          status: "approved",
          paymentMethod: "CARD",
          validaPayChargeId: previousChargeId,
          paymentId: previousChargeId,
          cardAttempt,
          updatedAtDate: new Date()
        });
        const finalization = await finalizeApprovedCard({ checkoutId, chargeId: previousChargeId });
        return {
          ok: true,
          approved: true,
          checkoutId,
          chargeId: previousChargeId,
          status: liveStatus,
          compraRegistrada: finalization.compraRegistrada === true,
          purchaseId: safe(finalization.purchaseId),
          tokenEntrega: safe(finalization.tokenEntrega),
          make: finalization.make
        };
      }

      if (!isTerminalCardFailure(liveStatus)) {
        await saveSession(checkoutId, {
          status: liveStatus || "pending",
          paymentMethod: "CARD",
          validaPayChargeId: previousChargeId,
          paymentId: previousChargeId,
          cardAttempt,
          updatedAtDate: new Date()
        });
        return {
          ok: true,
          recoverable: true,
          processing: true,
          chargeId: previousChargeId,
          status: liveStatus || "pending",
          error: "Já existe uma tentativa de cartão em análise. Aguardando a operadora antes de permitir outra cobrança."
        };
      }

      cardAttempt += 1;
    } else if (previousMethod === "CARD" && isTerminalCardFailure(previousStatus)) {
      cardAttempt += 1;
    }

    /* CARTAO_TOKENIZACAO_COM_FALLBACK_V1
       Cartão salvo exige token. Cartão novo tenta tokenizar por até 5 s;
       se a tokenização não responder, a cobrança segue pelo objeto card,
       formato oficialmente aceito pela mesma rota /v1/charges. */
    let tokenInfo = null;
    if (useSavedPaymentMethod) {
      const savedMethod = await buscarMetodoPagamentoPrivadoPorEmail(email);
      if (!savedMethod?.paymentMethodId || savedMethod.ativo === false) {
        return { ok:false, error:"Seu cartão salvo não está mais disponível. Informe um novo cartão." };
      }
      tokenInfo = {
        paymentMethodId: safe(savedMethod.paymentMethodId),
        customerId: safe(savedMethod.validaPayCustomerId),
        cardBrand: safe(savedMethod.cardBrand),
        cardLastFour: safe(savedMethod.cardLastFour),
        cardExpirationMonth: safe(savedMethod.cardExpirationMonth),
        cardExpirationYear: safe(savedMethod.cardExpirationYear),
        cardHolderName: safe(savedMethod.cardHolderName),
        cardDocument: safe(savedMethod.cardDocument || cardDocument)
      };
    } else {
      try {
        tokenInfo = await Promise.race([
          tokenizarNovoCartao({ number, cvv, month, year, holder, nome, cpfCnpj: cardDocument, email }),
          new Promise((_, reject) => setTimeout(() => reject(new Error("tokenization_timeout")), 5000))
        ]);
      } catch (error) {
        tokenInfo = null;
        console.warn("Tokenização ValidaPay indisponível; cobrança seguirá com cartão direto:", error?.message || error);
      }
    }

    const paymentMethodId = safe(tokenInfo?.paymentMethodId);
    if (useSavedPaymentMethod && !paymentMethodId) {
      return { ok:false, error:"Seu cartão salvo não pôde ser carregado. Informe um novo cartão." };
    }

    await saveSession(checkoutId, {
      status: "pending",
      paymentMethod: "CARD",
      clienteId,
      nomeCliente: nome,
      whatsapp,
      email,
      cpfCnpj,
      codigoProjeto,
      tipoProduto,
      produto,
      tituloCheckout,
      img: safe(input.img || ctx.img || ctx.imagem),
      valor,
      returnUrl: safe(input.returnUrl || ctx.returnUrl),
      compraRegistrada: false,
      cardAttempt,
      memberId,
      pendingPaymentMethodId: paymentMethodId,
      pendingValidaPayCustomerId: safe(tokenInfo?.customerId),
      pendingCardBrand: safe(tokenInfo?.cardBrand) || brand(number),
      pendingCardLastFour: safe(tokenInfo?.cardLastFour) || number.slice(-4),
      pendingCardExpirationMonth: safe(tokenInfo?.cardExpirationMonth) || month,
      pendingCardExpirationYear: safe(tokenInfo?.cardExpirationYear) || year,
      pendingCardHolderName: safe(tokenInfo?.cardHolderName) || holder,
      pendingCardDocument: digits(tokenInfo?.cardDocument || cardDocument),
      updatedAtDate: new Date()
    });

    const priceId = await ensurePriceId({ checkoutId, codigoProjeto, tipoProduto, produto, valor });
    if (!priceId) return { ok:false, error:"Não foi possível vincular o produto à cobrança ValidaPay. Nenhuma cobrança foi criada." };

    const chargePayload = {
      paymentMethod: "creditcard",
      externalId: cardAttemptExternalId(checkoutId, cardAttempt),
      externalTxid: `PP-${codigoProjeto}-CARD-${safe(checkoutId).replace(/[^a-z0-9]/gi, "").slice(-8)}`.slice(0, 35),
      customer: {
        name: nome,
        email,
        documentNumber: cpfCnpj,
        phone: whatsapp
      },
      paymentMethodId,
      installments,
      passFeesToCustomer: false,
      freeInstallments: 1,
      metadata: {
        origem: "PELEGO_BOX_PROJETOS_PRONTOS",
        checkoutId,
        clienteId,
        codigoProjeto,
        tipoProduto,
        produto,
        phone: whatsapp,
        whatsapp,
        email
      }
    };

    if (paymentMethodId) {
      chargePayload.paymentMethodId = paymentMethodId;
    } else {
      chargePayload.card = {
        number,
        cvv,
        name: holder,
        expiration: month + "/" + year
      };
    }

    chargePayload.items = [{ priceId, quantity: 1 }];

    const response = await api("post", "/v1/charges", chargePayload);

    if (!response.ok) {
      if (response.statusCode === 409) {
        const id = extractChargeId(response.data || {});
        if (id) {
          await saveSession(checkoutId, {
            validaPayChargeId: id,
            paymentId: id,
            paymentMethod: "CARD",
            status: "pending",
            cardAttempt,
            updatedAtDate: new Date()
          });
          return {
            ok: false,
            recoverable: true,
            chargeId: id,
            error: "A cobrança já foi enviada. Aguarde a confirmação antes de tentar novamente."
          };
        }
      }
      const declined = response.statusCode === 402;
      if (declined) {
        await saveSession(checkoutId, {
          status: "rejected",
          paymentMethod: "CARD",
          validaPayChargeId: "",
          paymentId: "",
          cardAttempt,
          updatedAtDate: new Date()
        });
      }
      return {
        ok: false,
        declined,
        status: declined ? "rejected" : "",
        error: response.error || "Cartão não aprovado."
      };
    }

    const id = extractChargeId(response.data || {});
    const status = extractChargeStatus(response.data || {});
    const approved = response.data?.success !== false && isApprovedCardStatus(status);

    await saveSession(checkoutId, {
      validaPayChargeId: id,
      paymentId: id,
      paymentMethod: "CARD",
      cardAttempt,
      status: approved ? "approved" : (status || "pending"),
      updatedAtDate: new Date()
    });

    let finalization = {
      compraRegistrada: false,
      make: { skipped: true, reason: "payment_not_approved_yet" }
    };

    if (approved) {
      finalization = await finalizeApprovedCard({ checkoutId, chargeId: id });
    }

    return {
      ok: response.data?.success !== false,
      approved,
      checkoutId,
      chargeId: id,
      status: status || (approved ? "approved" : "pending"),
      cardBrand: safe(tokenInfo?.cardBrand) || safe(response.data?.cardBrand) || brand(number),
      cardLastFour: safe(tokenInfo?.cardLastFour) || number.slice(-4),
      installments,
      amount: valor,
      productLinked: Boolean(priceId),
      phoneSent: whatsapp,
      compraRegistrada: finalization.compraRegistrada === true,
      purchaseId: safe(finalization.purchaseId),
      tokenEntrega: safe(finalization.tokenEntrega),
      make: finalization.make
    };
  } catch (error) {
    console.error("ERRO CARTAO VALIDAPAY:", error?.message || error);
    return { ok: false, error: error?.message || "Não foi possível processar o cartão." };
  }
}

export async function consultarCobrancaCartaoTransparente(input = {}) {
  try {
    const checkoutId=safe(input.checkoutId);
    if(!checkoutId) return {ok:false,error:"checkoutId ausente."};
    let session=await findSession(checkoutId);
    if(!session) return {ok:false,recoverable:true,error:"Sessão do cartão ainda não localizada."};
    const chargeId=safe(input.chargeId||session.validaPayChargeId||session.paymentId);
    if(!chargeId) return {ok:true,recoverable:true,processing:true,checkoutId,status:safe(session.status)||"pending"};
    if(safe(session.status).toLowerCase()==="approved") {
      const finalization=await finalizeApprovedCard({checkoutId,chargeId});
      return {ok:true,approved:true,checkoutId,chargeId,status:"paid",compraRegistrada:finalization.compraRegistrada===true,purchaseId:safe(finalization.purchaseId),tokenEntrega:safe(finalization.tokenEntrega),make:finalization.make};
    }
    const response=await api("get",`/v1/charges/${encodeURIComponent(chargeId)}`);
    if(!response.ok) return {ok:true,recoverable:true,processing:true,checkoutId,chargeId,status:safe(session.status)||"pending",error:response.error||"Consultando confirmação do cartão..."};
    const data=response.data||{};
    const status=extractChargeStatus(data);
    const approved=["paid","approved","succeeded"].includes(status);
    const declined=["rejected","declined","denied","failed","cancelled","canceled","expired","refused"].includes(status);
    await saveSession(checkoutId,{validaPayChargeId:chargeId,paymentId:chargeId,paymentMethod:"CARD",status:approved?"approved":(status||safe(session.status)||"pending"),updatedAtDate:new Date()});
    if(approved) {
      const finalization=await finalizeApprovedCard({checkoutId,chargeId});
      return {ok:true,approved:true,checkoutId,chargeId,status,compraRegistrada:finalization.compraRegistrada===true,purchaseId:safe(finalization.purchaseId),tokenEntrega:safe(finalization.tokenEntrega),make:finalization.make};
    }
    return {ok:!declined,approved:false,declined,processing:!declined,checkoutId,chargeId,status:status||"pending",error:declined?"Cartão não aprovado.":"Aguardando confirmação do cartão..."};
  } catch(error) {
    console.error("CONSULTA CARTAO VALIDAPAY:",error?.message||error);
    return {ok:true,recoverable:true,processing:true,error:"Aguardando confirmação do cartão..."};
  }
}
