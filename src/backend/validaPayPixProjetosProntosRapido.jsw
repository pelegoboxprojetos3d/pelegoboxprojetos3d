import wixData from "wix-data";
import { fetch } from "wix-fetch";
import { getSecret } from "wix-secrets-backend";

// PIX TRANSPARENTE RÁPIDO
// Mantém cliente, metadados, sessão e webhooks, mas tira criação de produto
// do caminho crítico. A cobrança nasce diretamente por amount.

const AUTH_URL = "https://oauth2.validapay.com.br/auth/token";
const API_BASE = "https://api.validapay.com.br";
const SESSIONS = "SessoesProjetosProntos2";
const DB = { suppressAuth: true };
const SITE_BASE = "https://www.pelegobox.com.br";
const MAKE_SECRET = "MAKE_VENDA_PROJETOS_PRONTOS_WEBHOOK";
const CHATBOT_SECRET = "RESPONDECHAT_VENDA_PROJETOS_PRONTOS_WEBHOOK";

let writeToken = "";
let writeExpires = 0;
let readToken = "";
let readExpires = 0;

const safe = v => String(v ?? "").trim();
const digits = v => safe(v).replace(/\D/g, "");
const sleep = ms => new Promise(resolve => setTimeout(resolve, ms));

function parseMoney(v) {
  if (typeof v === "number") return Number.isFinite(v) ? Number(v.toFixed(2)) : 0;
  let t = safe(v).replace(/[^\d,.-]/g, "");
  if (t.includes(",") && t.includes(".")) t = t.replace(/\./g, "").replace(",", ".");
  else if (t.includes(",")) t = t.replace(",", ".");
  const n = Number(t);
  return Number.isFinite(n) ? Number(n.toFixed(2)) : 0;
}

function phone(v) {
  let n = digits(v);
  if (n.startsWith("55") && (n.length === 12 || n.length === 13)) n = n.slice(2);
  return (n.length === 10 || n.length === 11) ? `+55${n}` : "";
}

function validEmail(v) {
  return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/i.test(safe(v).toLowerCase());
}

function type(v) {
  const t = safe(v).normalize("NFD").replace(/[\u0300-\u036f]/g, "").toUpperCase().replace(/[\s-]+/g, "_");
  return ["MEDIDAS", "GRAFICOS", "PROJETO_COMPLETO"].includes(t) ? t : "MEDIDAS";
}

function decodeTitle(v) {
  return safe(v)
    .replace(/&amp;quot;/gi, '"')
    .replace(/&quot;|&#34;|&#x22;/gi, '"')
    .replace(/&apos;|&#39;/gi, "'")
    .replace(/&amp;/gi, "&")
    .replace(/\s+/g, " ")
    .trim();
}

function normalizeStatus(v) {
  const s = safe(v).toUpperCase();
  if (["PAID", "APPROVED", "CONFIRMED", "SUCCEEDED"].includes(s)) return "approved";
  if (["FAILED", "REJECTED", "DECLINED", "DENIED", "REFUSED"].includes(s)) return "rejected";
  if (["CANCELED", "CANCELLED"].includes(s)) return "cancelled";
  if (s === "EXPIRED") return "expired";
  return "pending";
}

function externalTxid(checkoutId, projectCode, productType, amount) {
  const stage = productType === "GRAFICOS" ? "G" : productType === "PROJETO_COMPLETO" ? "P" : "M";
  const cents = Math.round(parseMoney(amount) * 100);
  const suffix = safe(checkoutId).replace(/[^a-z0-9]/gi, "").slice(-8).toUpperCase();
  return `PP-${digits(projectCode)}-${stage}-${cents}-${suffix}`.slice(0, 35);
}

async function readJson(response) {
  const text = await response.text();
  if (!text) return {};
  try { return JSON.parse(text); } catch (_) { return { raw: text }; }
}

function apiMessage(data, status) {
  return safe(data?.error?.message || data?.error_description || data?.message ||
    (typeof data?.error === "string" ? data.error : "") || data?.code || data?.raw) ||
    `ValidaPay respondeu HTTP ${status}.`;
}

async function getToken(scope, force = false) {
  const isWrite = scope === "checkouts/write";
  const cached = isWrite ? writeToken : readToken;
  const exp = isWrite ? writeExpires : readExpires;
  if (!force && cached && Date.now() < exp - 45000) return cached;

  const id = safe(await getSecret("VALIDAPAY_CLIENT_ID"));
  const secret = safe(await getSecret("VALIDAPAY_CLIENT_SECRET"));
  if (!id || !secret) throw new Error("Credenciais da ValidaPay não encontradas.");

  const body = [
    "grant_type=client_credentials",
    `client_id=${encodeURIComponent(id)}`,
    `client_secret=${encodeURIComponent(secret)}`,
    `scope=${encodeURIComponent(scope)}`
  ].join("&");

  const response = await fetch(AUTH_URL, {
    method: "post",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body
  });
  const data = await readJson(response);
  const token = safe(data?.access_token);
  if (!response.ok || !token) throw new Error(apiMessage(data, response.status));

  const expiresAt = Date.now() + Math.max(120, Number(data?.expires_in || 300)) * 1000;
  if (isWrite) { writeToken = token; writeExpires = expiresAt; }
  else { readToken = token; readExpires = expiresAt; }
  return token;
}

async function request(path, method = "get", body) {
  const scope = method.toLowerCase() === "post" ? "checkouts/write" : "pix.cob/read";
  for (let attempt = 1; attempt <= 2; attempt += 1) {
    const token = await getToken(scope, attempt > 1);
    const options = {
      method,
      headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" }
    };
    if (body !== undefined) options.body = JSON.stringify(body);
    const response = await fetch(`${API_BASE}${path}`, options);
    const data = await readJson(response);
    if (response.ok) return { ok: true, statusCode: response.status, data };
    if (attempt === 1 && [401, 403].includes(Number(response.status))) continue;
    return { ok: false, statusCode: response.status, data, error: apiMessage(data, response.status) };
  }
  return { ok: false, statusCode: 0, data: {}, error: "Falha ao consultar a ValidaPay." };
}

async function findSession(checkoutId) {
  if (!safe(checkoutId)) return null;
  const r = await wixData.query(SESSIONS).eq("checkoutId", safe(checkoutId)).limit(1).find({ ...DB, consistentRead: true });
  return r.items[0] || null;
}

async function saveSession(checkoutId, patch, known = undefined) {
  const current = known === undefined ? await findSession(checkoutId) : known;
  const item = { ...(current || {}), ...(patch || {}), checkoutId: safe(checkoutId) };
  const normalizedPhone = phone(item.whatsapp || item.whatsappE164 || item.whatsApp);
  if (normalizedPhone) item.whatsapp = normalizedPhone;
  delete item.whatsApp;
  delete item.whatsappE164;
  if (item.produto) item.produto = decodeTitle(item.produto);
  return current ? wixData.update(SESSIONS, item, DB) : wixData.insert(SESSIONS, item, DB);
}

function first(...values) {
  for (const v of values) if (safe(v)) return v;
  return "";
}

function chargeIdFrom(data = {}) {
  return safe(first(
    data?.chargeId, data?.id, data?.charge?.id, data?.payment?.chargeId,
    data?.data?.chargeId, data?.data?.id, data?.result?.chargeId, data?.result?.id,
    data?.error?.details?.chargeId, data?.details?.chargeId
  ));
}

function emvFrom(data = {}) {
  return safe(first(
    data?.pix?.emv, data?.emv, data?.payment?.pix?.emv, data?.charge?.pix?.emv,
    data?.data?.pix?.emv, data?.data?.emv, data?.result?.pix?.emv, data?.result?.emv,
    data?.pix?.copyPaste, data?.copyPaste, data?.pixCode, data?.brCode, data?.brcode
  ));
}

function qrFrom(data = {}) {
  return safe(first(
    data?.pix?.qrCode, data?.qrCode, data?.payment?.pix?.qrCode,
    data?.charge?.pix?.qrCode, data?.data?.pix?.qrCode, data?.data?.qrCode,
    data?.result?.pix?.qrCode, data?.result?.qrCode, data?.qr_code, data?.qrcode
  ));
}

function statusFrom(data = {}) {
  return normalizeStatus(first(data?.status, data?.charge?.status, data?.payment?.status, data?.data?.status));
}

function publicCharge(checkoutId, chargeId, data = {}, fallbackAmount = 0) {
  const status = statusFrom(data);
  const emv = emvFrom(data);
  return {
    ok: true,
    provider: "VALIDAPAY",
    paymentMethod: "PIX",
    checkoutId: safe(checkoutId),
    chargeId: safe(chargeId),
    status,
    approved: status === "approved",
    processing: !emv && status === "pending",
    recoverable: !emv && status === "pending",
    amount: parseMoney(first(data?.amount, data?.value, data?.total, data?.charge?.amount, fallbackAmount)),
    emv,
    qrCode: qrFrom(data),
    paidAt: safe(first(data?.paidAt, data?.payment?.paidAt))
  };
}

async function quickRead(checkoutId, chargeId, amount, attempts = 4) {
  let latest = {};
  for (let i = 1; i <= attempts; i += 1) {
    const r = await request(`/v1/charges/${encodeURIComponent(chargeId)}`, "get");
    if (r.ok) {
      latest = r.data || {};
      if (emvFrom(latest) || statusFrom(latest) !== "pending") break;
    } else if (![404, 408, 425, 429, 500, 502, 503, 504].includes(Number(r.statusCode))) {
      throw new Error(r.error || "Não foi possível consultar a cobrança.");
    }
    if (i < attempts) await sleep(250);
  }
  return publicCharge(checkoutId, chargeId, latest, amount);
}

async function optionalSecret(name) {
  try { return safe(await getSecret(name)); } catch (_) { return ""; }
}

async function postJson(url, payload) {
  const response = await fetch(url, {
    method: "post",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify(payload)
  });
  if (!response.ok) throw new Error(`Webhook respondeu HTTP ${response.status}.`);
}

async function notifyApproved(checkoutId, chargeId, charge) {
  const session = await findSession(checkoutId);
  if (!session) return;

  const amount = Number(session.valor || parseMoney(charge?.amount) || 0);
  const payload = {
    event: "venda_aprovada_PROJETOS_PRONTOS",
    origem: "PELEGO_BOX_PROJETOS_PRONTOS",
    provider: "VALIDAPAY",
    paymentMethod: "PIX",
    status: "approved",
    dataISO: new Date().toISOString(),
    checkoutId,
    chargeId,
    clienteId: safe(session.clienteId),
    nome: safe(session.nomeCliente),
    email: safe(session.email).toLowerCase(),
    whatsapp: phone(session.whatsapp),
    cpfCnpj: digits(session.cpfCnpj),
    produto: decodeTitle(session.produto),
    tipoProduto: type(session.tipoProduto),
    codigoProjeto: safe(session.codigoProjeto),
    codigoCheckout: safe(session.codigoCheckout),
    img: safe(session.img),
    valor: amount,
    valorFormatado: amount.toLocaleString("pt-BR", { style: "currency", currency: "BRL" }),
    deliveryUrl: `${SITE_BASE}/entregaprojetosprontos?checkout_id=${encodeURIComponent(checkoutId)}`
  };

  const patch = { updatedAtDate: new Date() };

  if (!session.emailEnviadoEm) {
    const makeUrl = await optionalSecret(MAKE_SECRET);
    if (makeUrl) {
      try { await postJson(makeUrl, payload); patch.emailEnviadoEm = new Date(); }
      catch (e) { console.error("Falha no webhook do Make:", e?.message || e); }
    }
  }

  if (session.chatbotVendaEnviado !== true) {
    const chatbotUrl = await optionalSecret(CHATBOT_SECRET);
    if (chatbotUrl) {
      try { await postJson(chatbotUrl, payload); patch.chatbotVendaEnviado = true; }
      catch (e) { console.error("Falha no webhook do Chatbot:", e?.message || e); }
    }
  }

  if (patch.emailEnviadoEm || patch.chatbotVendaEnviado === true) {
    await saveSession(checkoutId, patch, session);
  }
}

export async function criarCobrancaPixTransparente(input = {}) {
  const checkoutId = safe(input.checkoutId) || `ckpro_${Date.now().toString(36)}_${Math.random().toString(16).slice(2, 10)}`;
  try {
    const ctx = input.ctx || {};
    const projectCode = digits(first(input.codigoProjeto, ctx.codigoProjeto));
    const productType = type(first(input.tipoProduto, ctx.tipoProduto));
    const productName = decodeTitle(first(input.produto, ctx.produto, ctx.titulo, "Projeto Pronto"));
    const checkoutCode = safe(first(input.codigoCheckout, ctx.codigoCheckout));
    const amount = parseMoney(input.valor ?? ctx.valor ?? ctx.price);
    const clienteId = safe(first(input.clienteId, ctx.clienteId));
    const nome = decodeTitle(first(input.nomeCliente, input.nome, ctx.nomeCliente, ctx.nome));
    const buyerEmail = safe(first(input.email, ctx.email)).toLowerCase();
    const document = digits(first(input.cpfCnpj, input.cpf, ctx.cpfCnpj, ctx.cpf));
    const whatsapp = phone(first(input.whatsappE164, input.whatsapp, ctx.whatsappE164, ctx.whatsapp));
    const image = safe(first(input.img, input.imagem, ctx.img, ctx.imagem));
    const returnUrl = safe(first(input.returnUrl, ctx.returnUrl));

    if (!projectCode) return { ok: false, checkoutId, error: "Código do projeto não informado." };
    if (!(amount > 0)) return { ok: false, checkoutId, error: "Valor inválido para gerar o Pix." };
    if (!clienteId) return { ok: false, checkoutId, error: "Cliente não identificado." };
    if (nome.length < 3) return { ok: false, checkoutId, error: "Nome do cliente não informado." };
    if (!validEmail(buyerEmail)) return { ok: false, checkoutId, error: "E-mail do cliente inválido." };
    if (![11, 14].includes(document.length)) return { ok: false, checkoutId, error: "CPF/CNPJ do cliente inválido." };
    if (!whatsapp) return { ok: false, checkoutId, error: "WhatsApp do cliente inválido." };

    const existing = await findSession(checkoutId);
    const existingChargeId = safe(existing?.validaPayChargeId);
    if (existingChargeId) return quickRead(checkoutId, existingChargeId, amount, 2);

    const now = new Date();
    await saveSession(checkoutId, {
      status: "pending",
      paymentMethod: "PIX",
      clienteId,
      nomeCliente: nome,
      whatsapp,
      email: buyerEmail,
      cpfCnpj: document,
      codigoProjeto: projectCode,
      codigoCheckout: checkoutCode,
      tipoProduto: productType,
      produto: productName,
      img: image,
      valor: amount,
      returnUrl,
      compraRegistrada: false,
      validaPayChargeId: "",
      paymentId: "",
      createdAtDate: existing?.createdAtDate || now,
      updatedAtDate: now
    }, existing);

    const body = {
      paymentMethod: "pix",
      externalId: checkoutId,
      externalTxid: externalTxid(checkoutId, projectCode, productType, amount),
      customer: { name: nome, email: buyerEmail, phone: whatsapp, documentNumber: document },
      amount,
      metadata: {
        origem: "PELEGO_BOX_PROJETOS_PRONTOS",
        checkoutId,
        clienteId,
        codigoProjeto: projectCode,
        codigoCheckout: checkoutCode,
        tipoProduto: productType,
        produto: productName,
        whatsapp,
        cpfCnpj: document,
        imagem: image,
        returnUrl
      }
    };

    let created = null;
    let lastError = "";

    for (let attempt = 1; attempt <= 3; attempt += 1) {
      const r = await request("/v1/charges", "post", body);
      if (r.ok) {
        created = r.data || {};
        break;
      }

      const recovered = chargeIdFrom(r.data || {});
      if (r.statusCode === 409 && recovered) {
        created = { ...(r.data || {}), chargeId: recovered };
        break;
      }

      lastError = r.error || "Não foi possível gerar o Pix.";
      if (![408, 425, 429, 500, 502, 503, 504].includes(Number(r.statusCode))) {
        throw new Error(lastError);
      }
      if (attempt < 3) await sleep(250 * attempt);
    }

    const chargeId = chargeIdFrom(created || {});
    if (!chargeId) {
      return { ok: false, recoverable: true, processing: true, checkoutId, error: lastError || "O Pix ainda está sendo criado." };
    }

    await saveSession(checkoutId, {
      validaPayChargeId: chargeId,
      paymentId: chargeId,
      status: "pending",
      updatedAtDate: new Date()
    });

    const immediate = publicCharge(checkoutId, chargeId, created || {}, amount);
    if (immediate.emv || immediate.approved) return immediate;
    return quickRead(checkoutId, chargeId, amount, 4);

  } catch (error) {
    console.error("ERRO PIX RÁPIDO VALIDAPAY:", error?.message || error, error);
    return { ok: false, recoverable: true, processing: true, checkoutId, error: error?.message || "Não foi possível gerar o Pix." };
  }
}

export async function consultarCobrancaPix(input = {}) {
  try {
    const checkoutId = safe(input.checkoutId);
    let chargeId = safe(input.chargeId);
    let session = null;

    if (!chargeId && checkoutId) {
      session = await findSession(checkoutId);
      chargeId = safe(session?.validaPayChargeId);
    }

    if (!chargeId) {
      return { ok: false, recoverable: true, processing: true, checkoutId, error: "Preparando o Pix..." };
    }

    const r = await request(`/v1/charges/${encodeURIComponent(chargeId)}`, "get");
    if (!r.ok) {
      const recoverable = [404, 408, 425, 429, 500, 502, 503, 504].includes(Number(r.statusCode));
      return { ok: false, recoverable, processing: recoverable, checkoutId, chargeId, error: recoverable ? "Aguardando o QR Code..." : r.error };
    }

    const result = publicCharge(checkoutId, chargeId, r.data || {}, session?.valor || 0);

    if (checkoutId && result.approved) {
      const current = session || await findSession(checkoutId);
      await saveSession(checkoutId, {
        status: "approved",
        paymentId: chargeId,
        validaPayChargeId: chargeId,
        updatedAtDate: new Date()
      }, current);
      notifyApproved(checkoutId, chargeId, r.data || {}).catch(error => {
        console.error("Falha ao notificar venda aprovada:", error?.message || error);
      });
    }

    return result;
  } catch (error) {
    return { ok: false, recoverable: true, processing: true, checkoutId: safe(input.checkoutId), chargeId: safe(input.chargeId), error: "Aguardando retorno da ValidaPay..." };
  }
}
