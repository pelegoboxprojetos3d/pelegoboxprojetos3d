import wixData from "wix-data";
import { fetch } from "wix-fetch";
import { getSecret } from "wix-secrets-backend";
import { currentMember } from "wix-members-backend";
import { normalizarWhatsappBrasil, normalizarTituloProduto } from "backend/projetosProntosNormalizacao";

// TÍTULO NO WIX: backend/entregaProjetosProntos.jsw
// R6 — PROJETO PELO CÓDIGO + CLIENTE CANÔNICO + ENTREGA UNIFICADA

const SESSIONS_COLLECTION =
  "SessoesProjetosProntos2";

const PURCHASES_COLLECTION =
  "ComprasProjetos";

const PROJECTS_COLLECTION =
  "Videosprojetos";

const MAKE_PROCESS_SECRET =
  "MAKE_WEBHOOK_PROJETOS_PRONTOS";

const PROCESS_RETRY_MS =
  15000;

/*
  Nome visível: Clientes
  ID real da coleção no Wix: Campo
*/
const CLIENTS_COLLECTION =
  "Campo";

const DB_OPTS = {
  suppressAuth: true
};

const READ_OPTS = {
  ...DB_OPTS,
  consistentRead: true
};

function safe(value) {
  return String(value ?? "").trim();
}

function firstValue(...values) {
  for (const value of values) {
    const normalized = safe(value);

    if (normalized) {
      return normalized;
    }
  }

  return "";
}

function normalizeEmail(value) {
  return safe(value).toLowerCase();
}

function normalizeWhatsapp(value) {
  return safe(value).replace(/\D/g, "");
}

function normalizeProjectCode(value) {
  return safe(value).replace(/\D/g, "");
}

function normalizeType(value) {
  const type = safe(value)
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toUpperCase()
    .replace(/[\s-]+/g, "_");

  if (
    type === "MEDIDA" ||
    type === "MEDIDAS"
  ) {
    return "MEDIDAS";
  }

  if (
    type === "GRAFICO" ||
    type === "GRAFICOS"
  ) {
    return "GRAFICOS";
  }

  if (
    type === "PROJETO" ||
    type === "COMPLETO" ||
    type === "PROJETO_COMPLETO"
  ) {
    return "PROJETO_COMPLETO";
  }

  return "MEDIDAS";
}

function decodeTitle(value) {
  return safe(value)
    .replace(/&amp;quot;/gi, '"')
    .replace(/&quot;|&#34;|&#x22;/gi, '"')
    .replace(/&apos;|&#39;/gi, "'")
    .replace(/&amp;/gi, "&")
    .replace(/\s+/g, " ")
    .trim();
}

function cleanProjectTitle(value) {
  return normalizarTituloProduto(
    value
  );
}

function stripLeadingProjectCode(value) {
  return cleanProjectTitle(value)
    .replace(
      /^\s*#?\s*\d+\s*/i,
      ""
    )
    .trim();
}

function mediaSource(value) {
  if (!value) {
    return "";
  }

  if (typeof value === "string") {
    return value.trim();
  }

  if (typeof value === "object") {
    return firstValue(
      value.src,
      value.url,
      value.fileUrl,
      value.mediaUrl,
      value.image
    );
  }

  return "";
}

function referenceId(value) {
  if (!value) {
    return "";
  }

  if (typeof value === "string") {
    return safe(value);
  }

  if (typeof value === "object") {
    return firstValue(
      value._id,
      value.id,
      value.value
    );
  }

  return "";
}

function sessionWhatsapp(item) {
  return firstValue(
    item?.whatsappE164,
    item?.whatsapp,
    item?.whatsApp,
    item?.Whatsapp,
    item?.WhatsApp
  );
}

function sessionToken(item) {
  return firstValue(
    item?.tokenEntrega,
    item?.tokenDeEntrega
  );
}

function purchaseWhatsapp(item) {
  return firstValue(
    item?.whatsapp,
    item?.whatsApp,
    item?.Whatsapp,
    item?.WhatsApp,
    item?.["WhatsApp na compra"]
  );
}

function purchaseEmail(item) {
  return normalizeEmail(
    firstValue(
      item?.email,
      item?.Email,
      item?.["E-mail"],
      item?.emailCliente,
      item?.["E-mail da compra"]
    )
  );
}

function purchaseClientId(item) {
  return firstValue(
    item?.clienteId,
    item?.clienteID,
    item?.["Cliente ID"],
    item?.["ID do cliente"],
    referenceId(item?.cliente)
  );
}

function approvedPurchase(item) {
  const payment =
    safe(
      firstValue(
        item?.pagamento,
        item?.Pagamento,
        item?.formaPagamento
      )
    ).toLowerCase();

  const status =
    safe(
      firstValue(
        item?.statusCompra,
        item?.StatusCompra,
        item?.["Status Compra"],
        item?.["Status da compra"]
      )
    ).toLowerCase();

  return [
    "approved",
    "aprovada",
    "aprovado",
    "liberada",
    "liberado",
    "pago",
    "paga",
    "paid"
  ].includes(payment) || [
    "approved",
    "aprovada",
    "aprovado",
    "liberada",
    "liberado",
    "pago",
    "paga",
    "paid"
  ].includes(status);
}

function purchaseMatchesPayment(
  purchase,
  paymentId
) {
  const expected =
    safe(paymentId);

  return (
    expected &&
    safe(purchase?.idPagamento) ===
      expected
  );
}

function purchaseMatchesIdentity(
  purchase,
  identity
) {
  const clientId = safe(identity?.clienteId);
  const clientRef = safe(identity?.cliente?._id);
  const email = normalizeEmail(identity?.email);
  const whatsapp = normalizeWhatsapp(identity?.whatsapp);

  const itemClientId = purchaseClientId(purchase);
  const itemEmail = purchaseEmail(purchase);
  const itemWhatsapp = normalizeWhatsapp(
    purchaseWhatsapp(purchase)
  );

  if (
    clientId &&
    itemClientId &&
    clientId === itemClientId
  ) {
    return true;
  }

  if (
    clientRef &&
    itemClientId &&
    clientRef === itemClientId
  ) {
    return true;
  }

  if (
    email &&
    itemEmail &&
    email === itemEmail
  ) {
    return true;
  }

  if (
    whatsapp &&
    itemWhatsapp &&
    whatsapp === itemWhatsapp
  ) {
    return true;
  }

  return false;
}

function publicSession(item) {
  if (!item) {
    return null;
  }

  return {
    checkoutId:
      safe(item.checkoutId),

    status:
      safe(item.status)
        .toLowerCase(),

    paymentId:
      safe(item.paymentId),

    clienteId:
      safe(item.clienteId),

    nomeCliente:
      firstValue(
        item?.nomeCliente,
        item?.nome
      ),

    whatsapp:
      sessionWhatsapp(item),

    email:
      normalizeEmail(item.email),

    codigoProjeto:
      normalizeProjectCode(
        item.codigoProjeto
      ),

    tipoProduto:
      normalizeType(
        item.tipoProduto
      ),

    produto:
      safe(item.produto),

    img:
      mediaSource(item.img),

    valor:
      Number(item.valor || 0),

    returnUrl:
      safe(item.returnUrl),

    compraRegistrada:
      item.compraRegistrada === true,

    emailEnviado:
      item.emailEnviado === true,

    tokenEntrega:
      sessionToken(item)
  };
}

async function findOne(
  collection,
  field,
  value
) {
  if (
    value === undefined ||
    value === null ||
    safe(value) === ""
  ) {
    return null;
  }

  try {
    const result = await wixData
      .query(collection)
      .eq(field, value)
      .limit(1)
      .find(READ_OPTS);

    return result.items.length
      ? result.items[0]
      : null;
  } catch (error) {
    console.warn(
      `Busca em ${collection}.${field} falhou:`,
      error?.message || error
    );

    return null;
  }
}

async function findSession({
  checkoutId,
  token
}) {
  const id =
    safe(checkoutId);

  const deliveryToken =
    safe(token);

  if (deliveryToken) {
    const canonical =
      await findOne(
        SESSIONS_COLLECTION,
        "tokenEntrega",
        deliveryToken
      );

    if (canonical) {
      return canonical;
    }

    return findOne(
      SESSIONS_COLLECTION,
      "tokenDeEntrega",
      deliveryToken
    );
  }

  if (id) {
    return findOne(
      SESSIONS_COLLECTION,
      "checkoutId",
      id
    );
  }

  return null;
}

async function findProjectByOrder(
  codigoProjeto
) {
  const code =
    normalizeProjectCode(
      codigoProjeto
    );

  if (!code) {
    return null;
  }

  const numericCode =
    Number(code);

  if (Number.isSafeInteger(numericCode)) {
    const byNumber =
      await findOne(
        PROJECTS_COLLECTION,
        "ordem_video",
        numericCode
      );

    if (byNumber) {
      return byNumber;
    }
  }

  const byText =
    await findOne(
      PROJECTS_COLLECTION,
      "ordem_video",
      code
    );

  if (byText) {
    return byText;
  }

  try {
    const byTitle = await wixData
      .query(PROJECTS_COLLECTION)
      .startsWith(
        "titulo_video",
        `#${code}`
      )
      .limit(1)
      .find(READ_OPTS);

    return byTitle.items.length
      ? byTitle.items[0]
      : null;
  } catch (error) {
    console.warn(
      "Busca do projeto pelo título falhou:",
      error?.message || error
    );

    return null;
  }
}

async function findProject(session) {
  const codigoProjeto = normalizeProjectCode(session?.codigoProjeto);
  if (!codigoProjeto) return null;
  return findProjectByOrder(codigoProjeto);
}

async function queryPurchasesByProject(
  codigoProjeto
) {
  const code = normalizeProjectCode(codigoProjeto);

  if (!code) {
    return [];
  }

  const found = new Map();
  const attempts = [code];
  const numericCode = Number(code);

  if (Number.isSafeInteger(numericCode)) {
    attempts.push(numericCode);
  }

  for (const value of attempts) {
    try {
      const result = await wixData
        .query(PURCHASES_COLLECTION)
        .eq("codigoProjeto", value)
        .limit(1000)
        .find(READ_OPTS);

      for (const item of result.items || []) {
        const id = safe(item?._id);
        if (id) found.set(id, item);
      }
    } catch (error) {
      console.warn(
        "Busca de compras falhou:",
        value,
        error?.message || error
      );
    }
  }

  if (!found.size) {
    try {
      let result = await wixData
        .query(PURCHASES_COLLECTION)
        .limit(1000)
        .find(READ_OPTS);

      while (result) {
        for (const item of result.items || []) {
          const itemCode = normalizeProjectCode(
            firstValue(
              item?.codigoProjeto,
              item?.codigo_projeto,
              item?.codigo,
              item?.["Código do projeto"]
            )
          );

          if (itemCode === code) {
            const id = safe(item?._id);
            if (id) found.set(id, item);
          }
        }

        if (
          typeof result.hasNext !== "function" ||
          !result.hasNext()
        ) {
          break;
        }

        result = await result.next();
      }
    } catch (error) {
      console.warn(
        "Varredura de compatibilidade das compras falhou:",
        error?.message || error
      );
    }
  }

  return [...found.values()];
}

function newestFirst(items = []) {
  return [...items].sort(
    (a, b) => {
      const dateA =
        new Date(
          a?._updatedDate ||
          a?.dataProcessamento ||
          a?.dataLiberacao ||
          a?.dataCompra ||
          0
        ).getTime();

      const dateB =
        new Date(
          b?._updatedDate ||
          b?.dataProcessamento ||
          b?.dataLiberacao ||
          b?.dataCompra ||
          0
        ).getTime();

      return dateB - dateA;
    }
  );
}

function newestPurchaseValue(
  purchases,
  ...fields
) {
  for (
    const purchase of
    newestFirst(purchases)
  ) {
    for (const field of fields) {
      const value =
        safe(purchase?.[field]);

      if (value) {
        return value;
      }
    }
  }

  return "";
}

function clientPayload(item) {
  if (!item) {
    return {
      _id: "",
      clienteId: "",
      nome: "",
      email: "",
      whatsapp: ""
    };
  }

  return {
    _id: safe(item?._id),

    clienteId: firstValue(
      item?.clienteId,
      item?.clienteID,
      item?.["Cliente ID"],
      item?._id
    ),

    nome: firstValue(
      item?.nome,
      item?.nomeCliente,
      item?.Nomecliente,
      item?.title,
      item?.Title
    ),

    email: normalizeEmail(
      firstValue(
        item?.email,
        item?.Email,
        item?.["E-mail"]
      )
    ),

    whatsapp: firstValue(
      item?.whatsapp,
      item?.whatsApp,
      item?.Whatsapp,
      item?.WhatsApp
    )
  };
}

function isEmailAliasName(
  name,
  email
) {
  const normalizedName =
    safe(name).toLowerCase();

  const alias =
    normalizeEmail(email)
      .split("@")[0];

  return (
    normalizedName &&
    alias &&
    normalizedName === alias
  );
}

async function findClientProfile(
  session,
  purchases
) {
  const clienteId =
    firstValue(
      session?.clienteId,
      newestPurchaseValue(
        purchases,
        "clienteId"
      )
    );

  const email =
    firstValue(
      session?.email,
      newestPurchaseValue(
        purchases,
        "email"
      )
    );

  const whatsapp =
    firstValue(
      sessionWhatsapp(session),
      newestPurchaseValue(
        purchases,
        "whatsApp",
        "whatsapp"
      )
    );

  let item = null;

  if (clienteId) {
    item =
      await findOne(
        CLIENTS_COLLECTION,
        "clienteId",
        clienteId
      );

    if (!item) {
      item =
        await findOne(
          CLIENTS_COLLECTION,
          "_id",
          clienteId
        );
    }
  }

  if (!item && email) {
    item =
      await findOne(
        CLIENTS_COLLECTION,
        "email",
        normalizeEmail(email)
      );
  }

  if (!item && whatsapp) {
    const normalized =
      normalizeWhatsapp(whatsapp);

    item =
      await findOne(
        CLIENTS_COLLECTION,
        "whatsapp",
        normalized
      );

    if (!item) {
      const number =
        Number(normalized);

      if (Number.isSafeInteger(number)) {
        item =
          await findOne(
            CLIENTS_COLLECTION,
            "whatsapp",
            number
          );
      }
    }
  }

  const client =
    clientPayload(item);

  if (!client.nome) {
    const sessionName =
      firstValue(
        session?.nomeCliente,
        session?.nome
      );

    const purchaseName =
      newestPurchaseValue(
        purchases,
        "nomeCliente"
      );

    if (
      sessionName &&
      !isEmailAliasName(
        sessionName,
        email
      )
    ) {
      client.nome =
        sessionName;
    } else if (
      purchaseName &&
      !isEmailAliasName(
        purchaseName,
        email
      )
    ) {
      client.nome =
        purchaseName;
    }
  }

  client.clienteId =
    firstValue(
      client.clienteId,
      clienteId
    );

  client.email =
    firstValue(
      client.email,
      email
    );

  client.whatsapp =
    firstValue(
      client.whatsapp,
      whatsapp
    );

  return client;
}

function calculateAccess(purchases) {
  const access = {
    medidas: false,
    graficos: false,
    projeto: false
  };

  for (const purchase of purchases) {
    if (!approvedPurchase(purchase)) {
      continue;
    }

    const type =
      normalizeType(
        purchase?.tipoProduto
      );

    const hasProject =
      purchase?.downloadProjeto === true ||
      type === "PROJETO_COMPLETO";

    const hasGraphics =
      purchase?.downloadGraficos === true ||
      type === "GRAFICOS" ||
      hasProject;

    const hasMeasures =
      purchase?.downloadMedidas === true ||
      type === "MEDIDAS" ||
      hasGraphics;

    if (hasMeasures) {
      access.medidas = true;
    }

    if (hasGraphics) {
      access.graficos = true;
    }

    if (hasProject) {
      access.projeto = true;
    }
  }

  return {
    ...access,

    podeComprarMedidas:
      !access.medidas,

    podeComprarGraficos:
      access.medidas &&
      !access.graficos,

    podeComprarProjeto:
      access.graficos &&
      !access.projeto
  };
}

function resolveAccessFromPurchases({
  purchases,
  clienteId,
  email,
  whatsapp,
  paymentId
}) {
  const identity = {
    clienteId:
      safe(clienteId),

    email:
      normalizeEmail(email),

    whatsapp:
      normalizeWhatsapp(whatsapp)
  };

  const matched =
    purchases.filter(
      (item) =>
        purchaseMatchesIdentity(
          item,
          identity
        )
    );

  const currentPurchase =
    purchases.find(
      (item) =>
        purchaseMatchesPayment(
          item,
          paymentId
        )
    );

  if (
    currentPurchase &&
    !matched.some(
      (item) =>
        safe(item._id) ===
        safe(currentPurchase._id)
    )
  ) {
    matched.push(currentPurchase);
  }

  return {
    access:
      calculateAccess(matched),

    purchases:
      matched
  };
}

async function resolveAccess({
  codigoProjeto,
  clienteId,
  email,
  whatsapp,
  paymentId
}) {
  const purchases =
    await queryPurchasesByProject(
      codigoProjeto
    );

  return resolveAccessFromPurchases({
    purchases,
    clienteId,
    email,
    whatsapp,
    paymentId
  });
}

function arquivoAtualPronto(session, purchases, project) {
  const tipo = normalizeType(session?.tipoProduto);

  if (tipo === "PROJETO_COMPLETO") {
    return Boolean(
      firstMediaFromPurchases(
        purchases,
        "arquivoProjeto",
        "arquivo_projeto",
        "pdfProjeto"
      ) ||
      mediaSource(
        project?.arquivoProjeto ||
        project?.arquivo_projeto ||
        project?.pdfProjeto
      )
    );
  }

  if (tipo === "GRAFICOS") {
    const compra = [
      "imagemGrafico1",
      "imagemGrafico2",
      "imagemGrafico3",
      "imagemGrafico4"
    ].some((field) => Boolean(firstMediaFromPurchases(purchases, field)));

    const projeto = [
      project?.imagemGrafico1,
      project?.imagemGrafico2,
      project?.imagemGrafico3,
      project?.imagemGrafico4
    ].some((value) => Boolean(mediaSource(value)));

    return compra || projeto;
  }

  return Boolean(
    firstMediaFromPurchases(purchases, "imagemMedidas") ||
    mediaSource(project?.imagemMedidas)
  );
}

function processamentoAtrasado(purchase) {
  const stamp = new Date(
    purchase?.dataProcessamento ||
    purchase?._updatedDate ||
    0
  ).getTime();

  return !stamp || (Date.now() - stamp) >= PROCESS_RETRY_MS;
}

async function garantirProcessamentoAtual(session, purchases, client, project) {
  const paymentId = safe(session?.paymentId);
  const purchase =
    purchases.find((item) => purchaseMatchesPayment(item, paymentId)) ||
    newestFirst(purchases)[0] ||
    null;

  if (!purchase) {
    return { sent: false, reason: "purchase_not_found" };
  }

  if (arquivoAtualPronto(session, purchases, project)) {
    return { sent: false, reason: "asset_ready" };
  }

  const status = safe(purchase?.statusProcessamento).toUpperCase();

  if (status === "PROCESSANDO" && !processamentoAtrasado(purchase)) {
    return { sent: false, reason: "already_processing" };
  }

  let url = "";
  try {
    url = safe(await getSecret(MAKE_PROCESS_SECRET));
  } catch (_) {
    url = "";
  }

  if (!url) {
    return { sent: false, reason: "make_secret_missing" };
  }

  let processingPurchase = {
    ...purchase,
    statusProcessamento: "PROCESSANDO",
    dataProcessamento: new Date()
  };

  try {
    processingPurchase = await wixData.update(
      PURCHASES_COLLECTION,
      processingPurchase,
      DB_OPTS
    );
  } catch (_) {}

  const payload = {
    event: "pagamento_aprovado_projeto_pronto",
    clienteId: firstValue(client?.clienteId, session?.clienteId),
    nomeCliente: firstValue(client?.nome, session?.nomeCliente),
    email: normalizeEmail(firstValue(client?.email, session?.email)),
    whatsapp: normalizarWhatsappBrasil(
      firstValue(client?.whatsapp, sessionWhatsapp(session))
    ),
    cpfCnpj: safe(session?.cpfCnpj).replace(/\D/g, ""),
    codigoProjeto: normalizeProjectCode(session?.codigoProjeto),
    produto: safe(session?.produto),
    tipoProduto: normalizeType(session?.tipoProduto),
    valor: Number(session?.valor || processingPurchase?.valor || 0),
    pagamento: "approved",
    statusCompra: "approved",
    idPagamento: paymentId,
    checkoutId: safe(session?.checkoutId),
    tokenDeEntrega: sessionToken(session),
    chaveCompra: safe(processingPurchase?.chaveCompra)
  };

  try {
    const response = await fetch(url, {
      method: "post",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    if (!response.ok) {
      try {
        await wixData.update(
          PURCHASES_COLLECTION,
          {
            ...processingPurchase,
            statusProcessamento: "PENDENTE",
            dataProcessamento: new Date()
          },
          DB_OPTS
        );
      } catch (_) {}

      return { sent: false, reason: "make_http_error", status: response.status };
    }

    return { sent: true };
  } catch (error) {
    try {
      await wixData.update(
        PURCHASES_COLLECTION,
        {
          ...processingPurchase,
          statusProcessamento: "PENDENTE",
          dataProcessamento: new Date()
        },
        DB_OPTS
      );
    } catch (_) {}

    console.error(
      "Falha ao reenviar processamento para o Make:",
      error?.message || error
    );

    return { sent: false, reason: "make_fetch_error" };
  }
}

function stagePaymentValue(
  purchases,
  type,
  fallbackValue
) {
  const normalizedType =
    normalizeType(type);

  const exact = purchases
    .filter(approvedPurchase)
    .filter(
      (item) =>
        normalizeType(
          item?.tipoProduto
        ) === normalizedType
    )
    .sort((a, b) => {
      const dateA =
        new Date(
          a?._updatedDate ||
          a?.dataCompra ||
          0
        ).getTime();

      const dateB =
        new Date(
          b?._updatedDate ||
          b?.dataCompra ||
          0
        ).getTime();

      return dateB - dateA;
    });

  const value =
    Number(
      exact[0]?.valor ||
      fallbackValue ||
      0
    );

  return Number.isFinite(value)
    ? value
    : 0;
}

function buildStages(
  access,
  purchases,
  project
) {
  return {
    medidas: {
      pago:
        access.medidas === true,

      valorPago:
        stagePaymentValue(
          purchases,
          "MEDIDAS",
          project?.valor_medidas ||
          project?.valor_etapa_1
        )
    },

    graficos: {
      pago:
        access.graficos === true,

      valorPago:
        stagePaymentValue(
          purchases,
          "GRAFICOS",
          project?.valor_graficos ||
          project?.valor_etapa_2
        )
    },

    projeto: {
      pago:
        access.projeto === true,

      valorPago:
        stagePaymentValue(
          purchases,
          "PROJETO_COMPLETO",
          project?.valor_projeto ||
          project?.valor_etapa_3
        )
    }
  };
}

function firstMediaFromPurchases(
  purchases,
  ...fields
) {
  for (
    const purchase of
    newestFirst(purchases)
  ) {
    for (const field of fields) {
      const source =
        mediaSource(
          purchase?.[field]
        );

      if (source) {
        return source;
      }
    }
  }

  return "";
}

async function repairCurrentPurchase(
  session,
  purchases,
  client
) {
  const paymentId =
    safe(session?.paymentId);

  if (!paymentId) {
    return null;
  }

  const purchase =
    purchases.find(
      (item) =>
        purchaseMatchesPayment(
          item,
          paymentId
        )
    );

  if (!purchase) {
    return null;
  }

  const clientId =
    firstValue(
      client?.clienteId,
      session?.clienteId
    );

  const clientReference =
    firstValue(
      client?._id,
      referenceId(purchase?.cliente)
    );

  const clientName =
    safe(client?.nome);

  const email =
    firstValue(
      client?.email,
      session?.email
    );

  const whatsapp =
    firstValue(
      client?.whatsapp,
      sessionWhatsapp(session)
    );

  const checkoutId =
    safe(session?.checkoutId);

  const deliveryToken =
    sessionToken(session);

  const projectCode =
    normalizeProjectCode(
      session?.codigoProjeto ||
      purchase?.codigoProjeto
    );

  const purchaseKey =
    clientId && projectCode
      ? `${clientId}_${projectCode}`
      : "";

  const patch = {
    ...purchase
  };

  let changed = false;

  const setCanonical = (
    field,
    value
  ) => {
    if (
      value &&
      safe(patch[field]) !==
      safe(value)
    ) {
      patch[field] = value;
      changed = true;
    }
  };

  setCanonical(
    "clienteId",
    clientId
  );

  setCanonical(
    "nomeCliente",
    clientName
  );

  setCanonical(
    "email",
    normalizeEmail(email)
  );

  setCanonical(
    "whatsapp",
    normalizarWhatsappBrasil(whatsapp)
  );

  if (Object.prototype.hasOwnProperty.call(patch, "whatsApp")) {
    delete patch.whatsApp;
    changed = true;
  }

  setCanonical(
    "checkoutId",
    checkoutId
  );

  setCanonical(
    "tokenDeEntrega",
    deliveryToken
  );

  setCanonical(
    "chaveCompra",
    purchaseKey
  );

  if (
    clientName &&
    projectCode
  ) {
    const canonicalTitle =
      `PP-${projectCode} - ${clientName}`;

    if (
      safe(patch.title) !==
      canonicalTitle
    ) {
      patch.title =
        canonicalTitle;

      changed = true;
    }
  }

  if (
    safe(patch.pagamento)
      .toLowerCase() !== "approved"
  ) {
    patch.pagamento =
      "approved";

    changed = true;
  }

  if (
    safe(patch.statusCompra)
      .toLowerCase() !== "approved"
  ) {
    patch.statusCompra =
      "approved";

    changed = true;
  }

  if (!patch.dataLiberacao) {
    patch.dataLiberacao =
      new Date();

    changed = true;
  }

  if (
    !referenceId(patch.cliente) &&
    clientReference
  ) {
    patch.cliente =
      clientReference;

    changed = true;
  }

  if (changed) {
    return wixData.update(
      PURCHASES_COLLECTION,
      patch,
      DB_OPTS
    );
  }

  return purchase;
}

function canonicalProjectTitle(project, session) {
  const real = normalizarTituloProduto(project?.titulo_video || session?.produto);
  if (real) return real;
  const codigoProjeto = normalizeProjectCode(session?.codigoProjeto);
  return codigoProjeto ? `Projeto #${codigoProjeto}` : "Projeto Pronto";
}

function projectPayload(
  project,
  session,
  purchases,
  client
) {
  const codigoProjeto =
    normalizeProjectCode(
      session?.codigoProjeto
    );

  const imagemMedidas =
    firstMediaFromPurchases(
      purchases,
      "imagemMedidas"
    ) ||
    mediaSource(
      project?.imagemMedidas
    );

  const imagensGraficos = [
    firstMediaFromPurchases(
      purchases,
      "imagemGrafico1"
    ) ||
      mediaSource(
        project?.imagemGrafico1
      ),

    firstMediaFromPurchases(
      purchases,
      "imagemGrafico2"
    ) ||
      mediaSource(
        project?.imagemGrafico2
      ),

    firstMediaFromPurchases(
      purchases,
      "imagemGrafico3"
    ) ||
      mediaSource(
        project?.imagemGrafico3
      ),

    firstMediaFromPurchases(
      purchases,
      "imagemGrafico4"
    ) ||
      mediaSource(
        project?.imagemGrafico4
      )
  ].filter(Boolean);

  const pdfProject =
    firstMediaFromPurchases(
      purchases,
      "arquivoProjeto",
      "arquivo_projeto",
      "pdfProjeto"
    ) ||
    mediaSource(
      project?.arquivoProjeto ||
      project?.arquivo_projeto ||
      project?.pdfProjeto
    );

  const currentProcessingPurchase =
    purchases.find(
      (item) =>
        purchaseMatchesPayment(
          item,
          safe(session?.paymentId)
        )
    ) ||
    newestFirst(purchases)[0] ||
    null;

  const statusProcessamento =
    safe(
      currentProcessingPurchase
        ?.statusProcessamento
    ).toUpperCase();

  return {
    codigoProjeto,

    productId: safe(project?._id),

    titulo:
      canonicalProjectTitle(
        project,
        session
      ),

    nomeCliente:
      safe(client?.nome),

    clienteId:
      firstValue(
        client?.clienteId,
        session?.clienteId
      ),

    thumbnail:
      mediaSource(
        project?.thumbnail ||
        session?.img
      ),

    imagemMedidas,

    imagensGraficos,

    pdfProjeto:
      pdfProject,

    videoUrl:
      firstValue(
        project?.link_video,
        project?.linkVideo,
        project?.url_video,
        project?.urlVideo,
        project?.youtube,
        project?.youtubeUrl
      ),

    statusProcessamento,

    valorMedidas:
      Number(
        project?.valor_medidas ||
        project?.valor_etapa_1 ||
        0
      ),

    valorGraficos:
      Number(
        project?.valor_graficos ||
        project?.valor_etapa_2 ||
        0
      ),

    valorProjeto:
      Number(
        project?.valor_projeto ||
        project?.valor_etapa_3 ||
        0
      )
  };
}

async function identidadeMembroAtual() {
  let membro = null;

  try {
    membro = await currentMember.getMember();
  } catch (_) {
    return null;
  }

  if (!membro?._id) {
    return null;
  }

  const emailsContato =
    Array.isArray(membro?.contactDetails?.emails)
      ? membro.contactDetails.emails
      : [];

  const emails = emailsContato
    .map((item) =>
      typeof item === "string"
        ? item
        : firstValue(item?.email, item?.value)
    )
    .filter(Boolean);

  const email = normalizeEmail(
    firstValue(
      membro?.loginEmail,
      emails[0],
      membro?.contactDetails?.email
    )
  );

  const phonesContato =
    Array.isArray(membro?.contactDetails?.phones)
      ? membro.contactDetails.phones
      : [];

  const telefones = phonesContato
    .map((item) =>
      typeof item === "string"
        ? item
        : firstValue(
          item?.phone,
          item?.value,
          item?.number
        )
    )
    .map(normalizeWhatsapp)
    .filter(Boolean);

  const nomeMembro = firstValue(
    membro?.profile?.nickname,
    [
      safe(membro?.contactDetails?.firstName),
      safe(membro?.contactDetails?.lastName)
    ].filter(Boolean).join(" ")
  );

  const phoneVariants = new Set();

  for (const phone of telefones) {
    if (!phone) continue;
    phoneVariants.add(phone);
    phoneVariants.add(`+${phone}`);

    if (phone.startsWith("55") && phone.length >= 12) {
      phoneVariants.add(phone.slice(2));
    } else if (phone.length === 10 || phone.length === 11) {
      phoneVariants.add(`55${phone}`);
      phoneVariants.add(`+55${phone}`);
    }
  }

  const clientes = new Map();

  if (email) {
    for (const field of ["email", "Email"]) {
      try {
        const result = await wixData
          .query(CLIENTS_COLLECTION)
          .eq(field, email)
          .limit(20)
          .find(READ_OPTS);

        for (const item of result.items || []) {
          const id = safe(item?._id);
          if (id) clientes.set(id, item);
        }
      } catch (_) {}
    }
  }

  if (!clientes.size && phoneVariants.size) {
    for (const field of ["whatsapp", "whatsApp"]) {
      for (const value of phoneVariants) {
        try {
          const result = await wixData
            .query(CLIENTS_COLLECTION)
            .eq(field, value)
            .limit(20)
            .find(READ_OPTS);

          for (const item of result.items || []) {
            const id = safe(item?._id);
            if (id) clientes.set(id, item);
          }
        } catch (_) {}
      }
    }
  }

  let cliente = newestFirst(
    [...clientes.values()]
  )[0] || null;

  const sessoes = new Map();

  if (email) {
    for (const field of ["email", "Email"]) {
      try {
        const result = await wixData
          .query(SESSIONS_COLLECTION)
          .eq(field, email)
          .limit(50)
          .find(READ_OPTS);

        for (const item of result.items || []) {
          const id = safe(item?._id);
          if (id) sessoes.set(id, item);
        }
      } catch (_) {}
    }
  }

  if (!sessoes.size && phoneVariants.size) {
    for (const field of ["whatsapp", "whatsApp", "whatsappE164"]) {
      for (const value of phoneVariants) {
        try {
          const result = await wixData
            .query(SESSIONS_COLLECTION)
            .eq(field, value)
            .limit(50)
            .find(READ_OPTS);

          for (const item of result.items || []) {
            const id = safe(item?._id);
            if (id) sessoes.set(id, item);
          }
        } catch (_) {}
      }
    }
  }

  const sessao = newestFirst(
    [...sessoes.values()]
  )[0] || null;

  if (!cliente && sessao) {
    const sessionClientId = firstValue(
      sessao?.clienteId,
      sessao?.["Cliente ID"]
    );

    if (sessionClientId) {
      cliente =
        await findOne(
          CLIENTS_COLLECTION,
          "clienteId",
          sessionClientId
        );

      if (!cliente) {
        try {
          cliente = await wixData.get(
            CLIENTS_COLLECTION,
            sessionClientId,
            READ_OPTS
          );
        } catch (_) {
          cliente = null;
        }
      }
    }
  }

  const payloadCliente = clientPayload(cliente);

  return {
    memberId: safe(membro._id),
    cliente,
    clienteId: firstValue(
      payloadCliente.clienteId,
      sessao?.clienteId,
      sessao?.["Cliente ID"],
      cliente?._id
    ),
    nome: firstValue(
      payloadCliente.nome,
      sessao?.nomeCliente,
      sessao?.nome,
      nomeMembro
    ),
    email: firstValue(
      payloadCliente.email,
      normalizeEmail(sessao?.email),
      normalizeEmail(sessao?.Email),
      email
    ),
    whatsapp: firstValue(
      payloadCliente.whatsapp,
      sessionWhatsapp(sessao),
      telefones[0]
    )
  };
}

async function queryPurchasesByIdentity(identity = {}) {
  const found = new Map();

  const clientId = safe(identity?.clienteId);
  const clientRef = safe(identity?.cliente?._id);
  const email = normalizeEmail(identity?.email);
  const whatsapp = normalizeWhatsapp(identity?.whatsapp);

  const attempts = [];

  if (clientId) attempts.push(["clienteId", clientId]);
  if (clientRef) attempts.push(["cliente", clientRef]);
  if (email) attempts.push(["email", email]);

  const phoneValues = new Set();
  if (whatsapp) {
    phoneValues.add(whatsapp);
    phoneValues.add(`+${whatsapp}`);

    if (whatsapp.startsWith("55") && whatsapp.length >= 12) {
      phoneValues.add(whatsapp.slice(2));
    } else if (whatsapp.length === 10 || whatsapp.length === 11) {
      phoneValues.add(`55${whatsapp}`);
      phoneValues.add(`+55${whatsapp}`);
    }

    const whatsappNumber = Number(whatsapp);
    if (Number.isSafeInteger(whatsappNumber)) {
      phoneValues.add(whatsappNumber);
    }
  }

  for (const value of phoneValues) {
    attempts.push(["whatsapp", value]);
    attempts.push(["whatsApp", value]);
  }

  for (const [field, value] of attempts) {
    try {
      const result = await wixData
        .query(PURCHASES_COLLECTION)
        .eq(field, value)
        .limit(1000)
        .find(READ_OPTS);

      for (const item of result.items || []) {
        const id = safe(item?._id);
        if (id) found.set(id, item);
      }
    } catch (error) {
      console.warn(
        `Busca de compras do membro por ${field} falhou:`,
        error?.message || error
      );
    }
  }

  let matched = [...found.values()].filter((purchase) =>
    purchaseMatchesIdentity(purchase, identity)
  );

  if (!matched.length) {
    try {
      const fallback = new Map();
      let result = await wixData
        .query(PURCHASES_COLLECTION)
        .limit(1000)
        .find(READ_OPTS);

      while (result) {
        for (const item of result.items || []) {
          if (purchaseMatchesIdentity(item, identity)) {
            const id = safe(item?._id);
            if (id) fallback.set(id, item);
          }
        }

        if (
          typeof result.hasNext !== "function" ||
          !result.hasNext()
        ) {
          break;
        }

        result = await result.next();
      }

      matched = [...fallback.values()];
    } catch (error) {
      console.warn(
        "Varredura de compatibilidade das compras do membro falhou:",
        error?.message || error
      );
    }
  }

  return matched;
}

function acessoDescricao(access = {}) {
  if (access.projeto === true) {
    return "Medidas, gráficos e projeto completo";
  }

  if (access.graficos === true) {
    return "Medidas e gráficos";
  }

  return "Medidas";
}

export async function listarProjetosProntosDoMembroAtual() {
  const identity = await identidadeMembroAtual();

  if (!identity) {
    return {
      ok: false,
      error: "LOGIN_NECESSARIO",
      items: []
    };
  }

  const purchases = (await queryPurchasesByIdentity(identity))
    .filter(approvedPurchase);

  const grouped = new Map();

  for (const purchase of purchases) {
    const codigoProjeto = normalizeProjectCode(
      firstValue(
        purchase?.codigoProjeto,
        purchase?.codigo_projeto,
        purchase?.codigo,
        purchase?.["Código do projeto"]
      )
    );

    if (!codigoProjeto) continue;

    const current = grouped.get(codigoProjeto) || [];
    current.push(purchase);
    grouped.set(codigoProjeto, current);
  }

  const items = (
    await Promise.all(
      [...grouped.entries()].map(
        async ([codigoProjeto, compras]) => {
          const project = await findProjectByOrder(codigoProjeto);
          if (!project) return null;

          const access = calculateAccess(compras);
          const newest = newestFirst(compras)[0] || {};

          const timestamp = new Date(
            newest?._updatedDate ||
            newest?.dataLiberacao ||
            newest?.dataCompra ||
            0
          ).getTime();

          return {
            codigoProjeto,
            titulo: canonicalProjectTitle(
              project,
              { codigoProjeto, produto: newest?.produto }
            ),
            thumbnail: mediaSource(
              project?.thumbnail ||
              newest?.thumbnail ||
              newest?.imagemMedidas
            ),
            access,
            acessoTexto: acessoDescricao(access),
            atualizadoEm: Number.isFinite(timestamp)
              ? timestamp
              : 0
          };
        }
      )
    )
  )
    .filter(Boolean)
    .sort((a, b) => b.atualizadoEm - a.atualizadoEm);

  return {
    ok: true,
    memberId: identity.memberId,
    items
  };
}

export async function buscarSegundaViaProjetoPronto(input = {}) {
  const codigoProjeto = normalizeProjectCode(
    input.codigoProjeto
  );

  if (!codigoProjeto) {
    return {
      ok: false,
      error: "CODIGO_PROJETO_AUSENTE"
    };
  }

  const identity = await identidadeMembroAtual();

  if (!identity) {
    return {
      ok: false,
      error: "LOGIN_NECESSARIO"
    };
  }

  const allPurchases = await queryPurchasesByProject(
    codigoProjeto
  );

  const purchases = allPurchases
    .filter(approvedPurchase)
    .filter((purchase) =>
      purchaseMatchesIdentity(purchase, identity)
    );

  if (!purchases.length) {
    return {
      ok: false,
      error: "COMPRA_NAO_ENCONTRADA"
    };
  }

  const project = await findProjectByOrder(
    codigoProjeto
  );

  if (!project) {
    return {
      ok: false,
      error: "PROJETO_NAO_ENCONTRADO"
    };
  }

  const access = calculateAccess(purchases);
  const client = {
    ...clientPayload(identity.cliente),
    clienteId: firstValue(
      identity.clienteId,
      identity.cliente?._id
    ),
    nome: identity.nome,
    email: identity.email,
    whatsapp: identity.whatsapp
  };

  const tipoProduto = access.projeto
    ? "PROJETO_COMPLETO"
    : access.graficos
      ? "GRAFICOS"
      : "MEDIDAS";

  const session = {
    checkoutId: "",
    status: "approved",
    paymentId: "",
    clienteId: client.clienteId,
    nomeCliente: client.nome,
    email: client.email,
    whatsapp: client.whatsapp,
    codigoProjeto,
    tipoProduto,
    produto: canonicalProjectTitle(project, { codigoProjeto }),
    img: mediaSource(project?.thumbnail),
    valor: 0,
    returnUrl: "",
    compraRegistrada: true,
    emailEnviado: true,
    tokenEntrega: ""
  };

  const projectData = projectPayload(
    project,
    session,
    purchases,
    client
  );

  return {
    ok: true,
    approved: true,
    segundaVia: true,
    session,
    client,
    access,
    stages: buildStages(
      access,
      purchases,
      project
    ),
    project: projectData
  };
}

export async function obterAcessosProjeto(
  input = {}
) {
  const codigoProjeto =
    normalizeProjectCode(
      input.codigoProjeto
    );

  if (!codigoProjeto) {
    return {
      ok: false,
      error:
        "CODIGO_PROJETO_AUSENTE"
    };
  }

  const result =
    await resolveAccess({
      codigoProjeto,

      clienteId:
        input.clienteId,

      email:
        input.email,

      whatsapp:
        input.whatsApp ||
        input.whatsapp,

      paymentId:
        input.paymentId
    });

  return {
    ok: true,
    codigoProjeto,
    access:
      result.access
  };
}

export async function buscarEntregaProjetoPronto(
  input = {}
) {
  const session =
    await findSession({
      checkoutId:
        input.checkoutId,

      token:
        input.token
    });

  if (!session) {
    return {
      ok: false,
      error:
        "SESSAO_NAO_ENCONTRADA"
    };
  }

  const safeSession =
    publicSession(session);

  if (
    safeSession.status !==
    "approved"
  ) {
    return {
      ok: true,
      approved: false,

      status:
        safeSession.status ||
        "pending",

      session: {
        checkoutId:
          safeSession.checkoutId
      }
    };
  }

  /*
    A aprovacao da ValidaPay e a fonte de verdade do pagamento.
    compraRegistrada pode ficar false enquanto Make/OneDrive termina o
    processamento, portanto esse sinal nao pode bloquear a pagina de entrega.
  */

  const project =
    await findProject(session);

  if (!project) {
    return {
      ok: false,
      error:
        "PROJETO_NAO_ENCONTRADO"
    };
  }

  let allPurchases =
    await queryPurchasesByProject(
      safeSession.codigoProjeto
    );

  let client =
    await findClientProfile(
      session,
      allPurchases
    );

  await repairCurrentPurchase(
    session,
    allPurchases,
    client
  );

  allPurchases =
    await queryPurchasesByProject(
      safeSession.codigoProjeto
    );

  client =
    await findClientProfile(
      session,
      allPurchases
    );

  await garantirProcessamentoAtual(
    session,
    allPurchases,
    client,
    project
  );

  const result =
    resolveAccessFromPurchases({
      purchases:
        allPurchases,

      clienteId:
        safeSession.clienteId,

      email:
        safeSession.email,

      whatsapp:
        safeSession.whatsapp,

      paymentId:
        safeSession.paymentId
    });

  /* Sessao aprovada libera cumulativamente a etapa paga. */
  const currentType =
    normalizeType(
      safeSession.tipoProduto
    );

  const effectiveAccess = {
    ...result.access,
    medidas: true,
    graficos:
      result.access.graficos === true ||
      currentType === "GRAFICOS" ||
      currentType === "PROJETO_COMPLETO",
    projeto:
      result.access.projeto === true ||
      currentType === "PROJETO_COMPLETO"
  };

  effectiveAccess.podeComprarMedidas =
    !effectiveAccess.medidas;
  effectiveAccess.podeComprarGraficos =
    effectiveAccess.medidas &&
    !effectiveAccess.graficos;
  effectiveAccess.podeComprarProjeto =
    effectiveAccess.graficos &&
    !effectiveAccess.projeto;

  const projectData =
    projectPayload(
      project,
      session,
      result.purchases,
      client
    );

  return {
    ok: true,
    approved: true,

    session: {
      ...safeSession,

      nomeCliente:
        safe(client?.nome)
    },

    client,

    access:
      effectiveAccess,

    stages:
      buildStages(
        effectiveAccess,
        result.purchases,
        project
      ),

    project:
      projectData
  };
}
