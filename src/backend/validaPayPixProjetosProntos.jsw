import {
  criarCobrancaPixTransparente as criarPixCore,
  consultarCobrancaPix as consultarPixCore
} from "backend/validaPayPixProjetosProntosCoreR2.jsw";

/*
  Fachada oficial do Pix de Projetos Prontos.
  O core base continua responsável por cobrança, sessão e notificações.
  O R2 acrescenta uma leitura profunda de EMV/QR quando a ValidaPay devolve
  esses dados em estruturas aninhadas ou nomes diferentes.

  Regras preservadas:
  - sem SKU;
  - sem codigo_checkout;
  - Pix criado somente no clique;
  - mesmo checkoutId reaproveita a mesma tentativa;
  - sessão, polling e notificações continuam no core base.
*/
export async function criarCobrancaPixTransparente(input = {}) {
  return criarPixCore(input);
}

export async function consultarCobrancaPix(input = {}) {
  return consultarPixCore(input);
}
