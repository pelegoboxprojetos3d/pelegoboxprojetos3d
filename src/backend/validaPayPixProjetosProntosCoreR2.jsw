import { fetch } from "wix-fetch";
import { getSecret } from "wix-secrets-backend";
import {
  criarCobrancaPixTransparente as criarBase,
  consultarCobrancaPix as consultarBase
} from "backend/validaPayPixProjetosProntosCore.jsw";

const AUTH_URL = "https://oauth2.validapay.com.br/auth/token";
const API_BASE = "https://api.validapay.com.br";
let readToken = "";
let readExpiresAt = 0;

const safe = value => String(value ?? "").trim();

async function readJson(response) {
  const text = await response.text();
  if (!text) return {};
  try { return JSON.parse(text); } catch (_) { return { raw: text }; }
}

async function token(force = false) {
  if (!force && readToken && Date.now() < readExpiresAt - 45000) return readToken;
  const clientId = safe(await getSecret("VALIDAPAY_CLIENT_ID"));
  const clientSecret = safe(await getSecret("VALIDAPAY_CLIENT_SECRET"));
  if (!clientId || !clientSecret) throw new Error("Credenciais da ValidaPay não encontradas.");

  const response = await fetch(AUTH_URL, {
    method: "post",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: [
      "grant_type=client_credentials",
      `client_id=${encodeURIComponent(clientId)}`,
      `client_secret=${encodeURIComponent(clientSecret)}`,
      `scope=${encodeURIComponent("pix.cob/read")}`
    ].join("&")
  });
  const data = await readJson(response);
  const access = safe(data?.access_token);
  if (!response.ok || !access) throw new Error("Não foi possível autenticar a leitura do Pix.");
  readToken = access;
  readExpiresAt = Date.now() + Math.max(120, Number(data?.expires_in || 300)) * 1000;
  return access;
}

async function charge(chargeId) {
  for (let attempt = 1; attempt <= 2; attempt += 1) {
    const access = await token(attempt > 1);
    const response = await fetch(`${API_BASE}/v1/charges/${encodeURIComponent(chargeId)}`, {
      method: "get",
      headers: { Authorization: `Bearer ${access}`, "Content-Type": "application/json" }
    });
    const data = await readJson(response);
    if (response.ok) return data;
    if (attempt === 1 && [401, 403].includes(Number(response.status))) continue;
    throw new Error(`ValidaPay respondeu HTTP ${response.status}.`);
  }
  return {};
}

function walk(root, predicate, depth = 0, seen = new Set()) {
  if (depth > 9 || root == null) return "";
  if (typeof root === "string") return predicate("", root) ? safe(root) : "";
  if (typeof root !== "object" || seen.has(root)) return "";
  seen.add(root);

  for (const key of Object.keys(root)) {
    const value = root[key];
    if (typeof value === "string" && predicate(key, value)) return safe(value);
  }
  for (const key of Object.keys(root)) {
    const found = walk(root[key], predicate, depth + 1, seen);
    if (found) return found;
  }
  return "";
}

function deepEmv(data) {
  return walk(data, (key, value) => {
    const k = safe(key).toLowerCase();
    const v = safe(value);
    return (
      /emv|copy.?paste|pix.?code|br.?code|payload/.test(k) && v.length > 50
    ) || (
      /^000201/.test(v) && v.length > 70
    ) || (
      /BR\.GOV\.BCB\.PIX/i.test(v) && v.length > 70
    );
  });
}

function deepQr(data) {
  return walk(data, (key, value) => {
    const k = safe(key).toLowerCase();
    const v = safe(value);
    return /qr.?code|qrcode|qr.?base64/.test(k) && (
      /^data:image/i.test(v) || /^https?:\/\//i.test(v) || v.length > 150
    );
  });
}

async function enrich(result = {}) {
  const chargeId = safe(result?.chargeId);
  if (!chargeId || result?.emv) return result;

  try {
    const raw = await charge(chargeId);
    const emv = deepEmv(raw);
    const qrCode = deepQr(raw);
    if (!emv && !qrCode) return result;
    return {
      ...result,
      ok: true,
      processing: false,
      recoverable: false,
      emv: emv || safe(result?.emv),
      qrCode: qrCode || safe(result?.qrCode)
    };
  } catch (error) {
    console.warn("Fallback profundo Pix não encontrou QR/EMV:", error?.message || error);
    return result;
  }
}

export async function criarCobrancaPixTransparente(input = {}) {
  // PIX_CREATE_NO_EXTRA_DEEP_READ_V1: criação retorna assim que o core cria a cobrança.
  // A leitura profunda fica somente no consultarCobrancaPix, sem bloquear a tela inicial.
  return criarBase(input);
}

export async function consultarCobrancaPix(input = {}) {
  return enrich(await consultarBase(input));
}
