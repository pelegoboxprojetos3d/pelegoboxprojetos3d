import {
  criarCobrancaPixTransparente as criarPixCore,
  consultarCobrancaPix as consultarPixCore
} from "backend/validaPayPixProjetosProntosCore.jsw";

/*
  Fachada oficial do Pix de Projetos Prontos.
  Mantém o nome importado pelas páginas e delega ao core atual.

  O core ativo:
  - não depende de SKU;
  - não usa codigo_checkout;
  - não cria produto ValidaPay antes da cobrança;
  - preserva checkoutId para recuperar a mesma tentativa;
  - mantém sessão, consulta e notificações após aprovação.
*/
export async function criarCobrancaPixTransparente(input = {}) {
  return criarPixCore(input);
}

export async function consultarCobrancaPix(input = {}) {
  return consultarPixCore(input);
}
